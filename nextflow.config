/*
 * Root-level shim so `nextflow run stajichlab/Fungi_BFD -r main --pipeline BFD`
 * resolves correctly when the pipeline is pulled from GitHub. Nextflow's
 * repo-pull looks for nextflow.config/main.nf at the repository root; the real
 * pipeline code and its own nextflow.config live under nextflow/ (see
 * nextflow/main.nf, nextflow/nextflow.config), which Nextflow auto-loads once
 * mainScript points there. Deliberately not includeConfig'd here to avoid
 * double-loading nextflow/nextflow.config for local invocations, which already
 * pass -c nextflow/nextflow.config explicitly and launch from this directory.
 */

manifest {
    mainScript = 'nextflow/main.nf'
}
