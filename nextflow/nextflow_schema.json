{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/stajichlab/BigFungiData/main/nextflow/nextflow_schema.json",
    "title": "BigFungiData pipeline parameters",
    "description": "Parameter schema for the BigFungiData Nextflow pipelines (funannotate.nf prediction/annotation and BFD.nf functional annotation). Only command-line-facing and commonly tuned parameters are validated; deep infrastructure paths are typed as strings. Unlisted parameters are accepted (warn-only) so the shared config can carry profile-specific settings.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "description": "Sample sheet and run-scope options shared by all profiles.",
            "properties": {
                "samples": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to the samples.csv sample sheet. Validated against assets/schema_input.json.",
                    "default": "${launchDir}/samples.csv"
                },
                "n_test": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "If >0, restrict the run to the first n_test samples (testing/stub).",
                    "default": 0
                }
            }
        },
        "run_scope_filters": {
            "title": "Run scope and filters",
            "type": "object",
            "description": "Restrict which samples are processed and control the merge stage.",
            "properties": {
                "taxon": {
                    "type": "string",
                    "pattern": "^$|^[A-Za-z]+:.+$",
                    "description": "Restrict to one taxonomic group as RANK:VALUE (e.g. PHYLUM:Ascomycota). Empty = no filter.",
                    "default": ""
                },
                "asmid": {
                    "type": "string",
                    "description": "Restrict to a single assembly by exact ASMID. Empty = no filter.",
                    "default": ""
                },
                "merge_all": {
                    "type": "boolean",
                    "description": "true = MERGE collects all files in results/function/<tool>/; false = only this run's outputs.",
                    "default": false
                },
                "skip_merge": {
                    "type": "boolean",
                    "description": "Skip all MERGE_* steps (e.g. when running only new species).",
                    "default": true
                },
                "run_build_duckdb": {
                    "type": "boolean",
                    "description": "Rebuild db/BFD.duckdb from tables/*.parquet after MERGE_* steps complete.",
                    "default": false
                },
                "db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output dir for the rebuilt BFD.duckdb."
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "description": "Options that apply to every profile.",
            "properties": {
                "trace_report_suffix": {
                    "type": "string",
                    "description": "Suffix appended to the trace/report/timeline filenames so runs do not clobber each other. Defaults to the launch timestamp in yyyy-MM-dd_HH_mm_ss format.",
                    "hidden": true
                },
                "pipeline": {
                    "type": "string",
                    "enum": ["BFD", "compare_ani", "query_ani", "funannotate", "earlgrey_mask", "comparative", "phyling", "backfill_abinitio", "setup_symlinks"],
                    "description": "Selects which pipeline main.nf includes/runs (case-insensitive; see main.nf).",
                    "default": "BFD"
                }
            }
        },
        "funannotate_options": {
            "title": "funannotate.nf options",
            "type": "object",
            "description": "Genome cleaning, RNA-seq fetch, training, prediction and annotation controls.",
            "properties": {
                "target":            { "type": "string", "format": "directory-path", "description": "Output dir for genome annotation." },
                "training_target":   { "type": "string", "format": "directory-path", "description": "Output dir for funannotate training." },
                "taxondb":           { "type": "string", "format": "directory-path", "description": "Local persistent NCBI taxdump cache dir; auto-provisioned by SETUP_TAXONDB (md5-verified download), so this rarely needs to be set. Defaults to lib/taxdump/ under launchDir." },
                "proteins":          { "type": "string", "format": "file-path", "description": "Protein evidence FASTA for prediction." },
                "source":            { "type": "string", "format": "directory-path", "description": "Source genome assembly dir." },
                "seqcenter":         { "type": "string", "description": "Sequencing center label for GenBank submission.", "default": "NCBI" },
                "augustus_config":   { "type": "string", "format": "directory-path", "description": "AUGUSTUS_CONFIG_PATH." },
                "funannotate_db":    { "type": "string", "format": "directory-path", "description": "FUNANNOTATE_DB dir." },
                "min_contig_len":    { "type": "integer", "minimum": 0, "description": "Minimum contig length to retain when cleaning.", "default": 2000 },
                "clean_script":      { "type": "string", "format": "file-path", "description": "Genome FASTA cleaning script." },
                "fastq_hdr_script":  { "type": "string", "format": "file-path", "description": "FASTQ header fix script for Trinity." },
                "sbt_template":      { "type": "string", "format": "file-path", "description": "GenBank submission template (.sbt)." },
                "debug":             { "type": "boolean", "description": "Enable verbose debug output.", "default": false },
                "max_cpus":          { "type": "integer", "minimum": 1, "description": "Upper CPU bound for funannotate sub-tools.", "default": 64 },
                "suppress":          { "type": "string", "description": "Filename of ASMID suppress list (one ASMID per line).", "default": "suppress.txt" },
                "max_rnaseq_runs":   { "type": "integer", "minimum": 0, "description": "Max paired-end SRA runs to fetch per species.", "default": 2 },
                "max_rnaseq_spot":   { "type": "integer", "minimum": 0, "description": "Max spots per SRA run (0 = no cap).", "default": 0 },
                "max_rnaseq_reads":  { "type": "integer", "minimum": 0, "description": "Max reads to keep after normalization.", "default": 40000000 },
                "enable_single_end": { "type": "boolean", "description": "Allow single-end RNA-seq fallback.", "default": false },
                "max_rnaseq_se_runs":{ "type": "integer", "minimum": 0, "description": "Max single-end SRA runs per species.", "default": 3 },
                "only_clean":        { "type": "boolean", "description": "Stop after genome cleaning.", "default": false },
                "clean_batch_size":  { "type": "integer", "minimum": 0, "description": "Genomes per GENOME_CLEAN_BATCH job (0 = one job per genome).", "default": 1000 },
                "stop_after_sra_fetch": { "type": "boolean", "description": "Halt after SRA_FETCH.", "default": false },
                "stop_after_sra_query": { "type": "boolean", "description": "Halt after SRA_QUERY.", "default": false },
                "skip_sra_query":    { "type": "boolean", "description": "Reuse existing sra_query CSVs; skip SRA_QUERY_BATCH.", "default": false },
                "run_sra_fetch":     { "type": "boolean", "description": "Run the SRA fetch/normalize stage.", "default": true },
                "sra_query_batch_size": { "type": "integer", "minimum": 1, "description": "Species per SRA_QUERY_BATCH job.", "default": 10 },
                "run_repeatmasker":  { "type": "boolean", "description": "Run repeat masking.", "default": true },
                "run_update":        { "type": "boolean", "description": "Run funannotate update.", "default": false },
                "run_annotate":      { "type": "boolean", "description": "Run funannotate annotate.", "default": false },
                "run_antismash":     { "type": "boolean", "description": "Run antiSMASH.", "default": false },
                "rnaseq_data":       { "type": "string", "format": "directory-path", "description": "Trinity-GG cache dir." },
                "run_interpro":      { "type": "boolean", "description": "Run InterProScan in annotate.", "default": false },
                "run_signalp":       { "type": "boolean", "description": "Run SignalP.", "default": false },
                "antismash_taxon":   { "type": "string", "enum": ["fungi", "bacteria", "plants"], "description": "antiSMASH taxon mode.", "default": "fungi" },
                "pasa_mysql":        { "type": "boolean", "description": "Use MySQL/MariaDB-backed PASA.", "default": true },
                "rnaseq_trimmer":    { "type": "string", "enum": ["fastp", "trimmomatic"], "description": "RNA-seq read trimmer.", "default": "fastp" },
                "mariadb_sif":       { "type": "string", "format": "file-path", "description": "MariaDB singularity image for PASA." },
                "mysql_datadir":     { "type": "string", "format": "directory-path", "description": "MySQL data dir for PASA." },
                "pasa_conf_dir":     { "type": "string", "format": "directory-path", "description": "PASA conf dir." },
                "max_intronlen":     { "type": "integer", "minimum": 0, "description": "Max intron length for prediction.", "default": 3000 },
                "min_intronlen":     { "type": "integer", "minimum": 0, "description": "Min intron length for prediction.", "default": 10 },
                "predict_min_asm_bp":       { "type": "integer", "minimum": 0, "description": "Pre-flight: assembled bp below this counts as 'small' (0 disables the guard).", "default": 8000000 },
                "predict_frag_max_n50":     { "type": "integer", "minimum": 0, "description": "Pre-flight: N50 below this counts as 'fragmented'.", "default": 10000 },
                "predict_frag_max_contigs": { "type": "integer", "minimum": 0, "description": "Pre-flight: contig count above this counts as 'fragmented'.", "default": 1000 },
                "share_abinitio_params":    { "type": "boolean", "description": "Reuse trained AUGUSTUS/SNAP/GeneMark-ES parameters from a species' ANI-qualified representative instead of retraining per strain. See todo/species_level_abinitio_reuse.md.", "default": false },
                "abinitio_reuse_csv":       { "type": "string", "format": "file-path", "description": "species_reuse_clusters.py output CSV (species,out,is_representative,representative_out,ani_to_representative,reuse_eligible)." },
                "gene_prediction_shared_abinitio": { "type": "string", "format": "directory-path", "description": "Root of the species_reuse_clusters.py-backfilled shared ab-initio parameter stores (top-level, not nested under target)." },
                "force_independent_species":{ "type": "string", "description": "Comma-separated SPECIES values to always train independently, overriding reuse_eligible.", "default": "" },
                "predict_scope":     { "type": "string", "enum": ["all", "representative_only"], "description": "FUNANNOTATE_PREDICTION scope: 'all' predicts every strain (representatives first, no waiting); 'representative_only' predicts only representative strains.", "default": "all" },
                "busco_genome_dir":  { "type": "string", "format": "directory-path", "description": "BUSCO genome-mode results dir, consulted by ANI_REPRESENTATIVE_SELECT for representative selection." }
            }
        },
        "bfd_functional_options": {
            "title": "BFD.nf functional-annotation options",
            "type": "object",
            "description": "Input/output dirs and per-tool toggles for the functional annotation pipeline.",
            "properties": {
                "pep_dir":             { "type": "string", "format": "directory-path", "description": "Protein FASTA input dir." },
                "cds_dir":             { "type": "string", "format": "directory-path", "description": "CDS FASTA input dir." },
                "gff_dir":             { "type": "string", "format": "directory-path", "description": "GFF3 input dir." },
                "trna_dir":            { "type": "string", "format": "directory-path", "description": "tRNA input dir." },
                "genome_dir":          { "type": "string", "format": "directory-path", "description": "Genome DNA input dir." },
                "genome_annotation":   { "type": "string", "format": "directory-path", "description": "Annotation source dir." },
                "tables":              { "type": "string", "format": "directory-path", "description": "Consolidated table output dir." },
                "outdir":              { "type": "string", "format": "directory-path", "description": "Functional results dir." },
                "stats_outdir":        { "type": "string", "format": "directory-path", "description": "Sequence-stats results dir." },
                "genome_stats_outdir": { "type": "string", "format": "directory-path", "description": "Genome-stats results dir." },
                "run_setup":     { "type": "boolean", "default": true },
                "run_pfam":      { "type": "boolean", "default": true },
                "run_cazy":      { "type": "boolean", "default": true },
                "run_merops":    { "type": "boolean", "default": true },
                "run_swissprot": { "type": "boolean", "default": true, "description": "Run SwissProt homology search (RUN_SWISSPROT)." },
                "run_swissprot_annot": { "type": "boolean", "default": true, "description": "Build the SwissProt accession -> annotation table (BUILD_SWISSPROT_ANNOT)." },
                "swissprot_search": { "type": "string", "enum": ["diamond", "blastp"], "default": "diamond", "description": "SwissProt search engine: 'diamond' (diamond blastp --sensitive container) or 'blastp' (NCBI blastp container)." },
                "swissprot_max_targets": { "type": "integer", "minimum": 1, "default": 20, "description": "Max alignments per query (diamond -k / blastp -max_target_seqs)." },
                "swissprot_evalue": { "type": "number", "minimum": 0, "default": 1e-05, "description": "E-value cutoff for RUN_SWISSPROT." },
                "diamond_sif": { "type": "string", "format": "file-path", "description": "DIAMOND 2.2.5 Singularity image (default engine)." },
                "blastp_sif": { "type": "string", "format": "file-path", "description": "NCBI BLAST+ 2.16.0 Singularity image (blastp engine and RUN_MEROPS)." },
                "swissprot_dbdir": { "type": "string", "format": "directory-path", "description": "Dir holding uniprot_sprot.{dmnd,blastDB}." },
                "swissprot_dat": { "type": "string", "format": "file-path", "description": "uniprot_sprot.dat.gz flatfile consumed by BUILD_SWISSPROT_ANNOT." },
                "run_tmhmm":     { "type": "boolean", "default": true },
                "run_targetp":   { "type": "boolean", "default": true },
                "run_idp":       { "type": "boolean", "default": true },
                "run_wolfpsort": { "type": "boolean", "default": true },
                "run_predgpi":   { "type": "boolean", "default": true },
                "pfam_nodes":    { "type": "integer", "minimum": 1, "default": 1 },
                "pfam_tasks":    { "type": "integer", "minimum": 1, "default": 1 },
                "run_aa_freq":     { "type": "boolean", "default": true },
                "run_codon_freq":  { "type": "boolean", "default": true },
                "freq_batch_size": { "type": "integer", "minimum": 1, "default": 50 },
                "run_intergenic":  { "type": "boolean", "default": true },
                "run_gene_stats":  { "type": "boolean", "default": true },
                "run_asm_stats":   { "type": "boolean", "default": true },
                "run_chrom_info":  { "type": "boolean", "default": true },
                "run_telomeres":   { "type": "boolean", "default": true },
                "telomere_patterns":       { "type": "array", "items": { "type": "string" }, "description": "List of telomere monomer patterns to search (IUPAC allowed).", "default": ["TTAGGG"] },
                "telomere_min_repeats":    { "type": "integer", "minimum": 1, "description": "Minimum tandem repeat count to report a tract.", "default": 3 },
                "telomere_min_length":     { "type": "integer", "minimum": 1, "description": "Minimum tract length (bp) to report.", "default": 36 },
                "telomere_flank_window":   { "type": "integer", "minimum": 0, "description": "Inward flanking sequence length (bp) to report.", "default": 500 },
                "telomere_search_window":  { "type": "integer", "minimum": 1, "description": "Terminal window (bp) in which to search for telomeres.", "default": 5000 },
                "telomere_fuzzy":          { "type": "boolean", "default": false, "description": "Use fuzzy (approximate) repeat matching instead of exact regex." },
                "telomere_max_mismatch":   { "type": "integer", "minimum": 0, "description": "Max mismatches per monomer in fuzzy mode.", "default": 1 },
                "telomere_max_indel":      { "type": "integer", "minimum": 0, "description": "Max indels per monomer in fuzzy mode.", "default": 0 },
                "telomere_both_ends":      { "type": "boolean", "default": false, "description": "Search every pattern at both 5' and 3' ends (default: canonical orientation only)." },
                "telomere_allow_internal": { "type": "boolean", "default": false, "description": "Report non-terminal tracts inside the search window." },
                "telomere_terminal_tolerance": { "type": "integer", "minimum": 0, "description": "A tract is 'terminal' if within this many bp of the literal scaffold edge (assemblies often carry a few non-canonical bases before the repeat locks into register).", "default": 10 },
                "run_busco_genome":{ "type": "boolean", "default": false },
                "run_busco_pep":   { "type": "boolean", "default": false },
                "busco_lineage":   { "type": "string", "description": "BUSCO lineage dataset (e.g. fungi_odb12, ascomycota_odb12).", "default": "fungi_odb12" },
                "bfd_debug":       { "type": "boolean", "description": "Emit warnings when input files are missing (e.g. 'Skipping protein file'). Useful for debugging; set to false to suppress noisy skips during routine runs.", "default": false }
            }
        },
        "ani_options": {
            "title": "ANI (average nucleotide identity) comparison options",
            "type": "object",
            "description": "Parameters for compare_ANI.nf and query_ANI.nf workflows.",
            "properties": {
                "compare": {
                    "type": "string",
                    "enum": ["KINGDOM", "PHYLUM", "CLASS", "ORDER", "FAMILY", "GENUS", "SPECIES"],
                    "description": "Taxonomic rank to group genomes for comparison.",
                    "default": "GENUS"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "ANI results output directory.",
                    "default": "${launchDir}/results/ANI"
                },
                "ani_method": {
                    "type": "string",
                    "enum": ["skani", "mash", "sourmash", "fastani"],
                    "description": "ANI comparison tool.",
                    "default": "skani"
                },
                "sketch_cache": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory to cache per-genome sketches.",
                    "default": "${launchDir}/work/ANI/sketch_cache"
                },
                "phylo_outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Phylogenetic output directory."
                },
                "min_group_size": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Minimum genomes to form a comparison group.",
                    "default": 2
                },
                "ani_cluster_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "ANI % threshold for clustering.",
                    "default": 95.0
                },
                "ani_outlier_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "ANI % threshold for outlier detection.",
                    "default": 90.0
                },
                "skani_preset": {
                    "type": "string",
                    "enum": ["fast", "medium", "slow"],
                    "description": "skani sketch preset.",
                    "default": "medium"
                },
                "skani_min_af": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "skani minimum aligned fraction (%).",
                    "default": 15
                },
                "skani_compression": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "skani compression level (0 = use preset default).",
                    "default": 0
                },
                "skani_sketch_chunk": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Genomes sketched per skani job.",
                    "default": 50
                },
                "mash_kmer": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Mash k-mer size.",
                    "default": 21
                },
                "mash_sketch_size": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Mash sketch size.",
                    "default": 10000
                },
                "sourmash_kmer": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Sourmash k-mer size.",
                    "default": 21
                },
                "sourmash_scaled": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Sourmash scaled factor.",
                    "default": 1000
                },
                "fastani_fraglen": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "FastANI fragment length.",
                    "default": 3000
                },
                "fastani_kmer": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "FastANI k-mer size.",
                    "default": 16
                },
                "ani_batch_size": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Upper-triangle batch size (0 = single job per group).",
                    "default": 0
                },
                "fastani_prefilter": {
                    "type": "boolean",
                    "description": "Use mash pre-clustering for fastANI.",
                    "default": false
                },
                "prefilter_ani": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Mash ANI % floor for prefilter cascade.",
                    "default": 80.0
                },
                "query_rank": {
                    "type": "string",
                    "enum": ["KINGDOM", "PHYLUM", "CLASS", "ORDER", "FAMILY", "GENUS", "SPECIES"],
                    "description": "Taxonomic rank for query_ANI grouping.",
                    "default": "GENUS"
                },
                "query_top_n": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Keep top N reference hits per query.",
                    "default": 10
                },
                "fallback": {
                    "type": "boolean",
                    "description": "Group orphans by next rank above query_rank.",
                    "default": false
                },
                "run_ani_reuse": {
                    "type": "boolean",
                    "description": "Compute ANI-driven representative strain assignments.",
                    "default": false
                },
                "ani_reuse_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "ANI % threshold for strain reuse eligibility.",
                    "default": 99.0
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/run_scope_filters" },
        { "$ref": "#/$defs/generic_options" },
        { "$ref": "#/$defs/funannotate_options" },
        { "$ref": "#/$defs/bfd_functional_options" },
        { "$ref": "#/$defs/ani_options" }
    ]
}
