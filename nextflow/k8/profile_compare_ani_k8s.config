/*
 * conf/profile_compare_ani_k8s.config
 *
 * Kubernetes profile for workflows/compare_ANI.nf on Nautilus (National Research Platform).
 *
 * Unlike interproscan6 (see profile_interproscan6_k8s.config), compare_ANI needs NO
 * rewritten .nf file. Every ANI process (SKANI_COMPARE, FASTANI_COMPARE, MASH_*,
 * SOURMASH_*, REPORT_ANI, COMBINE_ANI_TABLE, PICK_REPRESENTATIVE_STRAIN, ...) already
 * runs a BioContainers OCI image with no `module load` and no nested Nextflow call —
 * the two things that forced IPS6 to get its own k8s-specific workflow file. Run
 * workflows/compare_ANI.nf as-is via main.nf, just swap the profile.
 *
 * ONE REAL GOTCHA vs. the IPS6 port — read this before running:
 * ─────────────────────────────────────────────────────────────
 * Six ANI report/component scripts are invoked as `${projectDir}/bin/<script>.py`
 * (not a bare filename) because the repo sets `process.shell = ['/bin/bash','-l']`
 * globally, and the login shell wipes the PATH that Nextflow would otherwise use to
 * auto-inject its `bin/` staging dir. That means the absolute path gets baked into
 * each task's .command.sh at pipeline-render time, on the *submitting* machine.
 * On Slurm that's fine (shared /bigdata NFS). On k8s it is NOT fine unless
 * `${projectDir}` also happens to be a path that exists inside every pod — i.e.
 * you must launch `nextflow run nextflow/main.nf ...` from a checkout of this repo
 * that lives ON the same PVC you mount into the pods, at the identical path.
 *   Affected scripts: combine_ani_table.py, pick_representative_strain.py,
 *   report_ani.py, report_query_ani.py, combine_query_calls.py,
 *   mash_components.py, sourmash_matrix_to_long.py
 * See stage_data_ani.sh step 2 and the README for how this is staged.
 *
 * One-time setup:
 *   1. Reuses the existing IPS6 PVC (k8/pvc.yaml → stajichlab-pvc) under a
 *      dedicated storageSubPath so no new PVC is required. If that PVC doesn't
 *      exist yet in your namespace, `kubectl apply -f k8/pvc.yaml -n <namespace>`
 *      first — ANI's own footprint is small (see stage_data_ani.sh comments).
 *   2. bash k8/stage_data_ani.sh --namespace <ns> --pvc stajichlab-pvc \
 *          --repo nextflow/ --genomes input/dna --samples samples.csv
 *   3. Launch from the staged repo checkout (see README_compare_ani.md Step 3).
 */

// ── Params — same shape as profile_ANI.config, paths moved onto the PVC ──────
params {
    augustus_config = ''

    // Container images: bare OCI refs — k8s pulls via containerd/CRI-O, no
    // 'docker://' prefix (that prefix is a Singularity URI scheme, not an OCI one).
    fastani_container  = 'quay.io/biocontainers/fastani:1.34--hb66fcc3_5'
    skani_container    = 'quay.io/biocontainers/skani:0.3.2--h79ce301_0'
    mash_container     = 'quay.io/biocontainers/mash:2.3--hb105d93_10'
    sourmash_container = 'quay.io/biocontainers/sourmash:4.9.4--hdfd78af_0'
    report_container   = 'python:3.12'

    samples               = '/workspace/ani/samples.csv'
    genome_dir            = '/workspace/ani/input/dna'
    genome_name_style     = 'species'
    genome_suffix         = '.scaffolds.fa'
    compare               = 'GENUS'
    taxon                 = ''
    min_group_size        = 2
    n_test                = 0
    ani_cluster_threshold = 95.0
    ani_outlier_threshold = 90.0
    outdir                = '/workspace/ani/results/ANI'
    ani_method            = 'skani'
    sketch_cache          = '/workspace/ani/work/sketch_cache'

    skani_preset          = 'medium'
    skani_min_af          = 15
    skani_compression     = 0
    skani_sketch_chunk    = 50

    mash_kmer             = 21
    mash_sketch_size      = 10000
    sourmash_kmer         = 21
    sourmash_scaled       = 1000
    fastani_fraglen       = 3000
    fastani_kmer          = 16
    ani_batch_size        = 0
    fastani_prefilter     = false
    prefilter_ani         = 80.0

    query_rank            = 'GENUS'
    query_top_n           = 10
    fallback              = false
    run_ani_reuse         = false
}

// ── Work directory (on the shared PVC so every task pod sees it) ────────────
workDir = '/workspace/ani/work/nf-work'

// ── Kubernetes executor ──────────────────────────────────────────────────────
executor {
    name            = 'k8s'
    queueSize       = 30          // max concurrent pods; check quota before raising
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '30 min'
}

k8s {
    // ── EDIT for your Nautilus namespace ─────────────────────────────────────
    namespace        = 'stajichlab'
    serviceAccount   = 'deployer'
    storageClaimName = 'stajichlab-pvc'   // reuse the IPS6 PVC (see k8/pvc.yaml)
    storageMountPath = '/workspace'
    storageSubPath   = 'ani'              // isolate ANI's files under one PVC
    // ──────────────────────────────────────────────────────────────────────────

    pullPolicy = 'IfNotPresent'
    launchDir  = '/workspace/ani'

    pod = [
        [annotation: 'nrp-nautilus.io/project', value: 'stajichlab-fungi-bfd-ani']
    ]
}

// ── Container runtime ─────────────────────────────────────────────────────────
docker {
    enabled    = true
    runOptions = '--user $(id -u):$(id -g)'
}
singularity.enabled = false

// process.shell defaults to ['/bin/bash','-l'] globally (nextflow.config) — that's
// what forces the ${projectDir}/bin/*.py absolute-path pattern noted above. Left
// as-is here rather than overridden, so the same rendered command works whether
// you're staring at .command.sh on Slurm or on a k8s pod.

// ── Process resources ─────────────────────────────────────────────────────────
process {
    // Nautilus bin-packs on requests==limits; mirror whatever cpus/memory each
    // label/process already computes so pods aren't OOM-killed or throttled.
    resourceLimits = { [ cpu: task.cpus, memory: task.memory ] }

    // Retry once on pod eviction/OOM (exit 137) or SIGTERM from preemption (143) —
    // Nautilus nodes are opportunistic/shared, unlike a reserved Slurm allocation.
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'fastani' {
        container = params.fastani_container
        // cpus/memory already scale with group_size inside FASTANI_COMPARE;
        // queue / clusterOptions / stageInMode dropped — Slurm-only directives.
    }

    withLabel: 'skani' {
        container = params.skani_container
        // SKANI_COMPARE's cpus/memory closures key off task.attempt for HPC queue
        // tiers (short/epyc/highmem). Queue tiers don't exist on k8s, but the
        // memory/cpu step-up on retry is still useful headroom, so leave it as-is.
    }

    withLabel: 'mash' {
        container = params.mash_container
    }

    withLabel: 'sourmash' {
        container = params.sourmash_container
    }

    withLabel: 'report' {
        container = params.report_container
        cpus      = 1
        memory    = '4 GB'
        // profile_ANI.config binds work/ANI/python_packages -> /tmp/python_packages
        // via singularity.runOptions so `pip install --target` survives across
        // report-stage tasks. K8s pods don't get arbitrary extra host binds, only
        // the one PVC mount — so COMBINE_ANI_TABLE's `pip install --target
        // /tmp/python_packages duckdb` just reinstalls into pod-local /tmp each
        // time. Fine: 'report' processes run once (or a handful of times) per
        // pipeline, not per-genome, so the reinstall cost is negligible.
    }

    withName: '.*_SKETCH' {
        cpus   = 2
        memory = '4 GB'
    }
}

// ── Cleanup: keep off until -resume is confirmed working across sessions ────
cleanup = false

// ── Trace / report / timeline (written to PVC) ───────────────────────────────
trace {
    enabled   = true
    file      = '/workspace/ani/logs/nextflow/ANI_k8s_trace.txt'
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = '/workspace/ani/logs/nextflow/ANI_k8s_report.html'
    overwrite = true
}
timeline {
    enabled   = true
    file      = '/workspace/ani/logs/nextflow/ANI_k8s_timeline.html'
    overwrite = true
}
