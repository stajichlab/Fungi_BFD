/*
 * k8/profile_compare_ani_k8s.config
 *
 * Kubernetes profile for workflows/compare_ANI.nf on Nautilus (NRP), via
 * main.nf --pipeline compare_ani -profile compare_ani_k8s.
 *
 * Unlike interproscan6 (see profile_interproscan6_k8s.config), compare_ANI needs
 * NO rewritten .nf file. Every ANI process (SKANI_COMPARE, FASTANI_COMPARE,
 * MASH_*, SOURMASH_*, REPORT_ANI, COMBINE_ANI_TABLE, PICK_REPRESENTATIVE_STRAIN,
 * ...) already runs a BioContainers OCI image with no `module load` and no
 * nested Nextflow call. Run workflows/compare_ANI.nf as-is via main.nf, just
 * swap the profile.
 *
 * This file was corrected against a live run on the actual ucr-stajichlab
 * Nautilus namespace (real skani comparison of 2 genomes staged from
 * s3://stajichlab/BFD, through a real k8s Job pod, publishing back to S3) —
 * every value below reflects what was actually needed, not what seemed
 * plausible on paper. The original draft got three things wrong that silently
 * fail otherwise; see the inline notes.
 *
 * THE REAL GOTCHA — verified, not just theorized:
 * ─────────────────────────────────────────────────────────────
 * Six ANI report/component scripts are invoked as `${projectDir}/bin/<script>.py`
 * (not a bare filename) because the repo sets `process.shell = ['/bin/bash','-l']`
 * globally, and the login shell wipes the PATH that Nextflow would otherwise use
 * to auto-inject its `bin/` staging dir. That path gets baked into each task's
 * .command.sh at pipeline-render time, on the machine that launches `nextflow
 * run` (the *head* process) — on Slurm that's fine (shared /bigdata NFS). On k8s
 * it is NOT fine unless `${projectDir}` also exists, at the identical path,
 * inside every task pod. Confirmed live: this only works when nextflow is
 * launched from a checkout of this repo that lives on the SAME PVC mounted
 * into every pod (see k8/stage_repo.sh) — not from a laptop or /bigdata copy.
 *   Affected scripts: combine_ani_table.py, pick_representative_strain.py,
 *   report_ani.py, report_query_ani.py, combine_query_calls.py,
 *   mash_components.py, sourmash_matrix_to_long.py
 *
 * Prerequisites (one-time; manifests in this k8/ directory):
 *   1. kubectl apply -f k8/pvc.yaml       (bfd-work-pvc, RWX, rook-cephfs)
 *   2. kubectl apply -f k8/rbac.yaml      (ServiceAccount 'nextflow-runner' +
 *      Role granting create/get/list/watch/delete on pods & configmaps, plus
 *      get/list/watch on pods/log & pods/status — the namespace's 'default'
 *      SA has none of this)
 *   3. A Secret 'nrp-s3-creds' with AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
 *      for the Ceph S3 gateway (never commit these; create directly with
 *      `kubectl create secret generic ...`, see README)
 *   4. k8/stage_repo.sh — clones/updates this repo onto the PVC and launches
 *      a persistent head pod (nextflow has to run from *inside* the cluster:
 *      `kuberun` is deprecated/unmaintained upstream, and without Fusion the
 *      k8s executor's workDir must be a POSIX volume shared by the head
 *      process and every task pod, which only mounts inside the cluster)
 *
 * nf-k8s ships as its own plugin as of Nextflow 24.x+, and its auto-install is
 * currently broken on 25.10.x (nextflow-io/nextflow#6583) — it must be
 * declared explicitly. Already added to the top-level nextflow.config
 * `plugins {}` block (can't be declared here: that block is only valid at the
 * top-most config scope, not inside a file loaded via includeConfig from
 * profiles{}). Omitting it fails with "Unknown executor name: k8s".
 */

// ── Params — genome data stays on S3; only workDir/repo live on the PVC ──────
params {
    augustus_config = ''

    // Container images: bare OCI refs — k8s pulls via containerd, no
    // 'docker://' prefix (that prefix is a Singularity URI scheme, not OCI).
    fastani_container  = 'quay.io/biocontainers/fastani:1.34--hb66fcc3_5'
    skani_container    = 'quay.io/biocontainers/skani:0.3.2--h79ce301_0'
    mash_container     = 'quay.io/biocontainers/mash:2.3--hb105d93_10'
    sourmash_container = 'quay.io/biocontainers/sourmash:4.9.4--hdfd78af_0'
    report_container   = 'python:3.12'

    // Real data lives in Ceph S3, not on the PVC — the aws{} block below lets
    // Nextflow's head process (running inside the cluster) stage these
    // to/from the PVC-backed workDir directly. Override genome_dir/outdir/
    // samples via -params-file for a real run (e.g. -params-file params_ani.yaml);
    // these are just usable defaults for a bare `-profile compare_ani_k8s` smoke test.
    samples               = 'samples.csv'
    genome_dir            = 's3://stajichlab/BFD/input_clean_genomes'
    genome_name_style     = 'asmid'
    genome_suffix         = '.masked.fasta.gz'
    compare               = 'GENUS'
    taxon                 = ''
    min_group_size        = 2
    n_test                = 0
    ani_cluster_threshold = 95.0
    ani_outlier_threshold = 90.0
    outdir                = 's3://stajichlab/BFD/results/ANI'
    ani_method            = 'skani'
    sketch_cache          = 'work/ANI/sketch_cache'

    skani_preset          = 'medium'
    skani_min_af          = 15
    skani_compression     = 0
    skani_sketch_chunk    = 50

    mash_kmer             = 21
    mash_sketch_size      = 10000
    sourmash_kmer         = 21
    sourmash_scaled       = 1000
    fastani_fraglen       = 3000
    fastani_kmer          = 16
    ani_batch_size        = 0
    fastani_prefilter     = false
    prefilter_ani         = 80.0

    query_rank            = 'GENUS'
    query_top_n           = 10
    fallback              = false
    run_ani_reuse         = false
}

// ── Work directory (on the shared PVC so every task pod sees it) ────────────
workDir = '/workspace/work/ANI'

// ── Kubernetes executor ──────────────────────────────────────────────────────
executor {
    name            = 'k8s'
    queueSize       = 30          // max concurrent pods; check quota before raising
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '30 min'
}

k8s {
    namespace        = 'ucr-stajichlab'    // verified: `kubectl config get-contexts`
    serviceAccount   = 'nextflow-runner'   // 'deployer' does not exist in this namespace
    storageClaimName = 'bfd-work-pvc'      // k8/pvc.yaml — 'stajichlab-pvc' (IPS6) doesn't exist here
    storageMountPath = '/workspace'
    // Nextflow sets a CPU *request* from each process's `cpus`, but no matching
    // CPU *limit* unless this is on. ucr-stajichlab's LimitRange defaults any
    // container with no explicit cpu limit to 100m, so every pod submission is
    // rejected (request > injected limit) without it. Verified live — the
    // alternative tried first, `process.resourceLimits = {[cpu: task.cpus, ...]}`,
    // does NOT reach the pod spec's cpu limit in nf-k8s 1.2.2 (only memory does);
    // this flag is the one that actually works.
    cpuLimits        = true

    // Container image caching on k8s: task pods pull plain OCI/Docker images
    // via each node's containerd, not Singularity SIF files — Nautilus is a
    // standard k8s cluster (no evidence of a Singularity/Apptainer runtimeClass;
    // a .sif path isn't a valid pod `image:` value without cluster-admin-level
    // runtime support). 'IfNotPresent' means a node that already pulled e.g.
    // quay.io/biocontainers/skani:... for one task reuses that same local layer
    // cache for every later task on that node, instead of re-pulling per pod.
    // This is per-node, not a shared cache across the whole cluster — a *fresh*
    // node still pulls once. There's no PVC-backed shared image cache to set up
    // here (unlike Singularity's cacheDir on the HPC/Slurm profiles): OCI image
    // caching is the container runtime's job, not something Nextflow or a
    // namespace user configures directly. At this pipeline's image sizes
    // (skani/mash/sourmash/fastani are all well under 100MB), a cold pull costs
    // seconds, not minutes, so this default is unlikely to be worth chasing
    // further unless profiling actually shows pull time dominating runtime.
    pullPolicy       = 'IfNotPresent'

    pod = [
        [annotation: 'nrp-nautilus.io/project', value: 'stajichlab-fungi-bfd-ani'],
        // Needed by REPORT_ANI specifically (see withLabel:'report' below) — it
        // combines storeDir + publishDir on the same s3:// path, which makes the
        // k8s executor embed a direct `aws s3 cp` call in that task's
        // .command.run, run inside the task pod itself. Every other process's
        // S3 I/O is staged by the head process's own JVM S3 client (using the
        // aws{} block below) and needs no credentials in the pod at all — this
        // is the one exception, verified live. Harmless to inject everywhere.
        [env: 'AWS_ACCESS_KEY_ID', secret: 'nrp-s3-creds/AWS_ACCESS_KEY_ID'],
        [env: 'AWS_SECRET_ACCESS_KEY', secret: 'nrp-s3-creds/AWS_SECRET_ACCESS_KEY'],
        // REPORT_ANI's embedded `aws s3 cp` call has no --endpoint-url (baked
        // into Nextflow's generated .command.run, not configurable from here),
        // so it defaults to real AWS and rejects our Ceph key outright. Recent
        // aws-cli/botocore honor this generic override env var.
        [env: 'AWS_ENDPOINT_URL', value: 'https://s3-west.nrp-nautilus.io']
    ]
}

// Ceph S3 gateway, NRP Nautilus "West" pool (matches s3://stajichlab/BFD).
// Credentials are NOT set here — Nextflow falls back to the standard
// AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, which the head pod gets
// from the nrp-s3-creds Secret (k8/stage_repo.sh / README). `region` is a
// required-but-unused placeholder for the AWS SDK; Ceph ignores it.
aws {
    region = 'us-east-1'
    client {
        endpoint          = 'https://s3-west.nrp-nautilus.io'
        s3PathStyleAccess = true
    }
}

// ── Container runtime ─────────────────────────────────────────────────────────
docker {
    enabled = true
    // No runOptions override (e.g. --user $(id -u):$(id -g)): tested without
    // one and every task ran fine as the image's default (root) user, including
    // writes to the PVC-backed workDir. Add one back only if you hit a
    // permission error — some images assume a non-root user is fine to run as,
    // but not all do, and getting it wrong produces a less obvious failure
    // than just leaving this alone.
}
singularity.enabled = false

// process.shell defaults to ['/bin/bash','-l'] globally (nextflow.config) — that's
// what forces the ${projectDir}/bin/*.py absolute-path pattern noted above. Left
// as-is here rather than overridden, so the same rendered command works whether
// you're staring at .command.sh on Slurm or on a k8s pod.

// COMBINE_ANI_TABLE reads its inputs by opening manifest-listed paths directly
// with plain Python `open()` (modules/ani/report/COMBINE_ANI_TABLE/main.nf +
// bin/combine_ani_table.py) rather than via normal Nextflow path staging — a
// deliberate optimization to avoid symlinking thousands of files at scale. That
// breaks when params.outdir is S3: the manifest holds each file's Nextflow
// Path.toString(), which for an S3 path renders scheme-stripped (e.g.
// "s3://bucket/key" -> "/bucket/key"), and Python's open() can't read either
// form anyway. Confirmed live: NOT k8s-specific — this would fail identically
// on Slurm with an S3-backed outdir. Worked around here, not in pipeline code:
// since the manifest string is deterministically "/" + outdir-without-scheme,
// mirroring that exact S3 prefix down to the identical absolute local path
// before the script runs makes open() find it with zero code changes.
// publishDir already copies outputs back to S3 with no extra work (verified).
def aniS3Prefix   = "${params.outdir}/${params.ani_method}/${params.compare}"
def aniLocalMirror = aniS3Prefix.replaceFirst(/^s3:\/\//, '/')

// ── Process resources ─────────────────────────────────────────────────────────
process {
    // Retry once on pod eviction/OOM (exit 137) or SIGTERM from preemption (143) —
    // Nautilus nodes are opportunistic/shared, unlike a reserved Slurm allocation.
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: '.*COMBINE_ANI_TABLE.*' {
        beforeScript = """
            pip install --quiet awscli >/dev/null 2>&1
            mkdir -p '${aniLocalMirror}'
            aws --endpoint-url https://s3-west.nrp-nautilus.io s3 sync --quiet '${aniS3Prefix}' '${aniLocalMirror}'
        """
    }

    withLabel: 'fastani' {
        container = params.fastani_container
        // cpus/memory already scale with group_size inside FASTANI_COMPARE;
        // queue / clusterOptions / stageInMode dropped — Slurm-only directives.
    }

    withLabel: 'skani' {
        container = params.skani_container
        // SKANI_COMPARE's cpus/memory closures key off task.attempt for HPC queue
        // tiers (short/epyc/highmem). Queue tiers don't exist on k8s, but the
        // memory/cpu step-up on retry is still useful headroom, so leave it as-is.
    }

    withLabel: 'mash' {
        container = params.mash_container
    }

    withLabel: 'sourmash' {
        container = params.sourmash_container
    }

    withLabel: 'report' {
        container = params.report_container
        cpus      = 1
        memory    = '4 GB'
        // profile_ANI.config binds work/ANI/python_packages -> /tmp/python_packages
        // via singularity.runOptions so `pip install --target` survives across
        // report-stage tasks. K8s pods don't get arbitrary extra host binds, only
        // the one PVC mount — so COMBINE_ANI_TABLE's `pip install --target
        // /tmp/python_packages duckdb` just reinstalls into pod-local /tmp each
        // time. Verified fine live: 'report' processes run once (or a handful of
        // times) per pipeline, not per-genome, so the reinstall cost is negligible.
        //
        // REPORT_ANI (the other process with this label) combines storeDir +
        // publishDir on the same s3:// path, which makes the k8s executor embed
        // an `aws s3 cp` call directly in that task's .command.run — the plain
        // python:3.12 image doesn't have it. (COMBINE_ANI_TABLE below has its
        // own, more specific override that replaces this beforeScript entirely
        // for that one process — Nextflow selector precedence is per-property,
        // not additive — so it re-installs awscli itself rather than relying on
        // this one.)
        beforeScript = 'pip install --quiet awscli >/dev/null 2>&1'
    }

    withName: '.*_SKETCH' {
        cpus   = 2
        memory = '4 GB'
    }
}

// ── Cleanup: keep off until -resume is confirmed working across sessions ────
cleanup = false

// ── Trace / report / timeline (written to PVC) ───────────────────────────────
trace {
    enabled   = true
    file      = "/workspace/logs/nextflow/ANI_k8s_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "/workspace/logs/nextflow/ANI_k8s_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "/workspace/logs/nextflow/ANI_k8s_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
