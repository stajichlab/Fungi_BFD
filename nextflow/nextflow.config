/*
 * Nextflow configuration for BigFungiData pipelines.
 *
 * Activate a pipeline family with -profile:
 *   -profile BFD           → BFD.nf + genome_seqstats.nf
 *   -profile funannotate   → funannotate.nf
 *   -profile comparative   → comparative_genomics.nf
 *   -profile interproscan6 → interproscan6.nf
 *   -profile earlgrey      → earlgrey_mask.nf
 *
 * Shared params (samples, n_test) live here; everything else is in conf/profile_*.config.
 * Trace/report/timeline files are scoped per-profile and suffixed with
 * params.trace_report_suffix (a YYYY-MM-DD_hh_mm_ss launch timestamp) so runs
 * never clobber each other.
 */

manifest {
    name            = 'BigFungiData'
    description     = 'Fungal genome annotation and statistics'
    version         = '1.0'
    nextflowVersion = '>=25.10'
}

// ── Schema validation (nf-schema) ─────────────────────────────────────────────
// Provides parameter typing (nextflow_schema.json), samples.csv validation
// (assets/schema_input.json), `--help`, and a params summary. Only enforced where
// a workflow calls validateParameters(); pipelines that don't are unaffected.
plugins {
    id 'nf-schema@2.6.1'
    // Required for -profile *_k8s (see conf/profile_k8s.config). Declared
    // here rather than inside the profile because `plugins {}` is only
    // valid at the top-most config scope, not inside an includeConfig'd
    // file loaded from within profiles{}. Harmless when a non-k8s profile
    // is active — the plugin just isn't exercised.
    id 'nf-k8s'
}

validation {
    parametersSchema = "${projectDir}/nextflow_schema.json"
    lenientMode      = true   // coerce e.g. "2" <-> 2 so config-set values don't false-fail
    // Unlisted profile params warn instead of aborting (failUnrecognisedParams defaults false).
    // `--help` is handled explicitly in each workflow via paramsHelp() (see *.nf).
}

// ── Shared params ─────────────────────────────────────────────────────────────
// Safe placeholder defaults for all profiles. Pipeline-specific overrides live
// in conf/profile_<pipeline>.config (which is only loaded for that pipeline).
// Without these, params that are only defined in one profile produce warnings
// when any other pipeline runs.
params {
    samples               = "${launchDir}/samples.csv"
    n_test                = 0
    outdir                = "${launchDir}/results"
    genome_stats_outdir   = "${launchDir}/results/genome_stats"
    tables                = "${launchDir}/tables"
    // Output dir for BUILD_DUCKDB's BFD.duckdb (bin/build_BFD_duckDB.sh, rebuilt
    // from tables/*.parquet -- see dbDir() in modules/common/utils.nf).
    db                    = "${launchDir}/db"
    sketch_cache          = "${launchDir}/work/sketch_cache"
    ani_method            = 'skani'
    compare               = 'GENUS'
    genome_dir            = "${launchDir}/input_clean_genomes"
    skani_preset          = 'medium'
    skani_min_af          = 15
    mash_kmer             = 21
    mash_sketch_size      = 10000
    sourmash_kmer         = 21
    sourmash_scaled       = 1000
    // Local persistent cache dir for the NCBI taxdump; SETUP_TAXONDB downloads,
    // md5-verifies, and extracts it here once (storeDir), so this rarely needs
    // overriding. lib/ (not work/) because workDir profiles set cleanup = true.
    taxondb               = "${launchDir}/lib/taxdump"
    // ── AAFTF Singularity container (replaces `module load AAFTF`) ──────────────
    // Used by CALC_ASM_STATS (AAFTF assess) and GENOME_CLEAN/_BATCH (AAFTF
    // fcs_gx_purge + in-image taxonkit). Built from github.com/stajichlab/AAFTF
    // AAFTF.def by that repo's release CI (skip_db_download=1, so the image has
    // no DB baked in). The image hardcodes AAFTF_DB=/opt/aaaftf_db and AAFTF
    // fcs_gx_purge needs the host-staged FCS-GX db in /dev/shm, so the modules
    // invoke it with these binds:
    //   --bind ${taxondb}:${taxondb},/srv/projects/db/AAFTF_DB:/opt/aaaftf_db,/dev/shm:/dev/shm
    aaftf_sif             = "/bigdata/stajichlab/shared/lib/singularity_cache/AAFTF.sif"
    // HMMER 3.4 SIF for RUN_PFAM's hmmsearch. Only the non-MPI path
    // (pfam_tasks=1, the production default) uses it; the pfam_tasks>1 branch
    // still loads the hmmer/3.4-mpi module because the SIF has no MPI runtime
    // and --mpi needs the cluster's OpenMPI/PMI wiring (see T-015).
    pfam_sif              = "/bigdata/stajichlab/shared/lib/singularity_cache/hmmer_3.4--hdbdd923_1.sif"
    // DIAMOND container for RUN_SWISSPROT's default engine
    // (diamond blastp --sensitive). quay.io/biocontainers/diamond:2.2.5 is the
    // most recent diamond: newer than the host `diamond` module (2.1.24) and
    // than the official getwilds/diamond:latest image (2.1.16).
    diamond_sif           = "/bigdata/stajichlab/shared/lib/singularity_cache/diamond_2.2.5--he361c42_0.sif"
    // NCBI BLAST+ 2.16.0 container. Used as RUN_SWISSPROT's alternative
    // engine (params.swissprot_search = 'blastp') and by RUN_MEROPS (host
    // `module load ncbi-blast` removed — version is now pinned).
    blastp_sif            = "/bigdata/stajichlab/shared/lib/singularity_cache/depot.galaxyproject.org-singularity-blast-2.16.0--h66d330f_5.img"
    // SwissProt 2026_02 assets staged under lib/swissprot (release pinned in
    // reldate.txt) from the always-current UniProt FTP URL:
    //   https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete/
    //   uniprot_sprot.dmnd  — DIAMOND db (built with diamond 2.1.24; read fine by 2.2.5)
    //   uniprot_sprot.{phr,pin,psq,...} — NCBI BLAST db (makeblastdb 2.16.0, 575,503 seqs)
    //   uniprot_sprot.dat.gz — flatfile source for BUILD_SWISSPROT_ANNOT
    // Both RUN engines rely on the DBS being present; these are NOT auto-downloaded.
    swissprot_dbdir       = "${projectDir}/lib/swissprot"
    swissprot_dat         = "${projectDir}/lib/swissprot/uniprot_sprot.dat.gz"
    // SwissProt search engine for RUN_SWISSPROT: 'diamond' (default) or 'blastp'.
    swissprot_search      = 'diamond'
    swissprot_max_targets = 20
    swissprot_evalue      = 1e-5
    target                = "${launchDir}/genome_annotation"
    // Print the parameter help message and exit (handled in each workflow via paramsHelp).
    help    = false
    // Restrict the run to a single taxonomic group.
    // Pass as --taxon RANK:VALUE (e.g. --taxon PHYLUM:Ascomycota or --taxon CLASS:Dothideomycetes).
    // Available ranks: PHYLUM, SUBPHYLUM, CLASS, SUBCLASS, ORDER, FAMILY, GENUS
    taxon      = ''
    // Restrict the run to a single genome assembly by ASMID (e.g. --asmid GCA_000001405.15).
    // When set, only the row in samples.csv whose ASMID matches is processed.
    asmid      = ''
    // ASMID suppress list (one ASMID per line; '#' comments and blank lines
    // ignored) applied by every samples.csv-driven pipeline (BFD, funannotate,
    // ANI) via loadSuppressSet()/suppressRowFilter() in modules/common/utils.nf.
    // Global default here (rather than per-profile) since nf-schema's JSON-schema
    // "default" is doc/validation-only and is never auto-applied to the live
    // params map.
    suppress   = 'suppress.txt'
    // MERGE scope: true = all files in results/function/<tool>/ (default),
    //              false = only files produced in the current run.
    merge_all  = false
    // Set to true to skip all MERGE_* steps (e.g. when running only new species
    // and deferring the full merge to a separate step).
    skip_merge = true
    // Rebuild the master db/BFD.duckdb from tables/*.parquet after MERGE_* steps
    // complete (bin/build_BFD_duckDB.sh). Off by default: it's a full rebuild
    // every time (no incremental upsert, per its own header comment), so it's
    // opt-in rather than tacked onto every merge run.
    run_build_duckdb = false
    // Suffix appended to trace/report/timeline filenames so repeated or concurrent
    // runs never clobber each other's logs. Launch timestamp, 24-hour clock.
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH_mm_ss')
    // Comparative genomics project name (required for --pipeline comparative)
    project      = ''
    // PHYling output root: phylogeny/{taxon_slug}/{seq_type}/{markerset}/
    phylo_outdir = "${launchDir}/phylogeny"
    // BFD.nf debug: emit verbose warnings when input files are missing (e.g. "Skipping protein file").
    bfd_debug    = false

    // ── Telomere finder defaults (used by --pipeline BFD) ─────────────────────
    run_telomeres          = false
    telomere_patterns      = ['TTAGGG', 'TCAGGG', 'TTGGGG', 'CCCTAA', 'CCCTGA',
                              'CCCCAA', 'TTAGGGTCAACA', 'TTATTAGGG', 'TTTATTAGGG',
                              'TTATTGGGG', 'TTATTGGGTTT', 'TTATTGGGTGT', 'TTAGGGTTTGGT']
    telomere_min_repeats   = 3
    telomere_min_length    = 36
    telomere_flank_window  = 500
    telomere_search_window = 5000
    telomere_fuzzy         = false
    telomere_max_mismatch  = 1
    telomere_max_indel     = 0
    telomere_both_ends     = false
    telomere_allow_internal = false
}

// ── SLURM executor (shared by all profiles) ───────────────────────────────────
executor {
    name            = 'slurm'
    queueSize       = 400
    submitRateLimit = '30/1min'
    pollInterval    = '1 min'
    exitReadTimeout = '30 min'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    // `-l` (login shell) is required so this cluster's module system is initialised
    // inside the task. IMPORTANT SIDE EFFECT: Nextflow auto-appends the pipeline's
    // bin/ to PATH in .command.run (`export PATH="$PATH:<projectDir>/bin"`), but that
    // export happens in the wrapper, which then invokes .command.sh via `/bin/bash -l`.
    // The login-shell startup chain (/etc/profile -> user profile) rebuilds PATH from
    // a fixed baseline and DISCARDS the appended bin/ entry. Verified empirically:
    // with `-l` a bare `subset_samples.py` is NOT on PATH and does not run; with the
    // shell forced to plain `/bin/bash` the identical process finds and runs it.
    // => Never call bin/ helpers by bare name. Always use ${projectDir}/bin/<script>.
    shell          = ['/bin/bash', '-l']
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    cache          = 'lenient'
    clusterOptions = '-N 1 -n 1'
}

singularity {
    enabled      = false
    autoMounts   = true
    cacheDir     = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    BFD           { includeConfig 'conf/profile_BFD.config'           }
    funannotate   { includeConfig 'conf/profile_funannotate.config'   }
    comparative   { includeConfig 'conf/profile_comparative.config'   }
    interproscan6 { includeConfig 'conf/profile_interproscan6.config' }
    phyling       { includeConfig 'conf/profile_phyling.config'       }
    ani           { includeConfig 'conf/profile_ANI.config'           }
    ani_query     {
        includeConfig 'conf/profile_ANI.config'
        includeConfig 'conf/profile_ANI_query.config'
    }
    earlgrey      { includeConfig 'conf/profile_earlgrey.config'      }
    // Nautilus (NRP) k8s pilot for compare_ANI — see k8/README_compare_ani.md
    // before using: requires one-time PVC + data staging (k8/stage_data_ani.sh)
    // and must be launched from a staged repo checkout, not this /bigdata copy.
    compare_ani_k8s { includeConfig 'k8/profile_compare_ani_k8s.config' }
    test_funannotate { includeConfig 'conf/test_funannotate.config' }
    test_ani      { includeConfig 'conf/test_ani.config'             }
    test          { includeConfig 'conf/test.config'                  }
    stub {
        includeConfig 'conf/test.config'
        params.n_test = 2
    }
}
