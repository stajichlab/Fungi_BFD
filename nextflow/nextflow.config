/*
 * Nextflow configuration for BigFungiData pipelines.
 *
 * Activate a pipeline family with -profile:
 *   -profile BFD           → BFD.nf + genome_seqstats.nf
 *   -profile funannotate   → funannotate.nf
 *   -profile comparative   → comparative_genomics.nf
 *   -profile interproscan6 → interproscan6.nf
 *   -profile earlgrey      → earlgrey_mask.nf
 *
 * Shared params (samples, n_test) live here; everything else is in conf/profile_*.config.
 * Trace/report/timeline files are scoped per-profile and suffixed with
 * params.trace_report_suffix (a YYYY-MM-DD_hh_mm_ss launch timestamp) so runs
 * never clobber each other.
 */

manifest {
    name            = 'BigFungiData'
    description     = 'Fungal genome annotation and statistics'
    version         = '1.0'
    nextflowVersion = '>=25.10'
}

// ── Schema validation (nf-schema) ─────────────────────────────────────────────
// Provides parameter typing (nextflow_schema.json), samples.csv validation
// (assets/schema_input.json), `--help`, and a params summary. Only enforced where
// a workflow calls validateParameters(); pipelines that don't are unaffected.
plugins {
    id 'nf-schema@2.6.1'
}

validation {
    parametersSchema = "${projectDir}/nextflow_schema.json"
    lenientMode      = true   // coerce e.g. "2" <-> 2 so config-set values don't false-fail
    // Unlisted profile params warn instead of aborting (failUnrecognisedParams defaults false).
    // `--help` is handled explicitly in each workflow via paramsHelp() (see *.nf).
}

// ── Shared params ─────────────────────────────────────────────────────────────
// Safe placeholder defaults for all profiles. Pipeline-specific overrides live
// in conf/profile_<pipeline>.config (which is only loaded for that pipeline).
// Without these, params that are only defined in one profile produce warnings
// when any other pipeline runs.
params {
    samples               = "${launchDir}/samples.csv"
    n_test                = 0
    outdir                = "${launchDir}/results"
    genome_stats_outdir   = "${launchDir}/results/genome_stats"
    sketch_cache          = "${launchDir}/work/sketch_cache"
    ani_method            = 'skani'
    compare               = 'GENUS'
    skani_preset          = 'medium'
    skani_min_af          = 15
    mash_kmer             = 21
    mash_sketch_size      = 10000
    sourmash_kmer         = 21
    sourmash_scaled       = 1000
    // Print the parameter help message and exit (handled in each workflow via paramsHelp).
    help    = false
    // Restrict the run to a single taxonomic group.
    // Pass as --taxon RANK:VALUE (e.g. --taxon PHYLUM:Ascomycota or --taxon CLASS:Dothideomycetes).
    // Available ranks: PHYLUM, SUBPHYLUM, CLASS, SUBCLASS, ORDER, FAMILY, GENUS
    taxon      = ''
    // Restrict the run to a single genome assembly by ASMID (e.g. --asmid GCA_000001405.15).
    // When set, only the row in samples.csv whose ASMID matches is processed.
    asmid      = ''
    // MERGE scope: true = all files in results/function/<tool>/ (default),
    //              false = only files produced in the current run.
    merge_all  = false
    // Set to true to skip all MERGE_* steps (e.g. when running only new species
    // and deferring the full merge to a separate step).
    skip_merge = true
    // Suffix appended to trace/report/timeline filenames so repeated or concurrent
    // runs never clobber each other's logs. Launch timestamp, 24-hour clock.
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH_mm_ss')
}

// ── SLURM executor (shared by all profiles) ───────────────────────────────────
executor {
    name            = 'slurm'
    queueSize       = 400
    submitRateLimit = '30/1min'
    pollInterval    = '1 min'
    exitReadTimeout = '30 min'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    shell          = ['/bin/bash', '-l']
    errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries     = 2
    cache          = 'lenient'
    clusterOptions = '-N 1 -n 1'
}

singularity {
    enabled      = false
    autoMounts   = true
    cacheDir     = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
}

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {
    BFD           { includeConfig 'conf/profile_BFD.config'           }
    funannotate   { includeConfig 'conf/profile_funannotate.config'   }
    comparative   { includeConfig 'conf/profile_comparative.config'   }
    interproscan6 { includeConfig 'conf/profile_interproscan6.config' }
    phyling       { includeConfig 'conf/profile_phyling.config'       }
    ani           { includeConfig 'conf/profile_ANI.config'           }
    ani_query     {
        includeConfig 'conf/profile_ANI.config'
        includeConfig 'conf/profile_ANI_query.config'
    }
    earlgrey      { includeConfig 'conf/profile_earlgrey.config'      }
    test_funannotate { includeConfig 'conf/test_funannotate.config' }
    test          { includeConfig 'conf/test.config'                  }
    stub {
        includeConfig 'conf/test.config'
        params.n_test = 2
    }
    //k8s_bfd {
    //    includeConfig 'conf/profile_k8s.config'
    //    includeConfig 'conf/profile_BFD_k8s.config'
    //}
}
