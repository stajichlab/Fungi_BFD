// conf/profile_BFD_k8s.config
process {
    withLabel: 'pfam' {
        container = 'quay.io/biocontainers/hmmer:3.4--pyhdfd78af_0'
        cpus      = 4
        memory    = '32 GB'
        time      = '8 h'
        // Script must change: no `module load`, use $params.pfam_db directly
    }

    withLabel: 'cazy' {
        container = 'quay.io/biocontainers/dbcanlight:1.0.3--pyhdfd78af_0'
        cpus      = 16
        memory    = '8 GB'
        time      = '2 h'
    }

    withLabel: 'merops' {
        container = 'quay.io/biocontainers/blast:2.16.0--hc155240_4'
        cpus      = 8
        memory    = '4 GB'
        time      = '2 h'
    }

    withLabel: 'signalp' {
        container      = 'ghcr.io/biosig-group/signalp6:6.0g'  // check availability
        cpus           = 8
        memory         = '64 GB'
        time           = '2 h'
        // GPU request for K8s:
        accelerator    = [request: 1, type: 'nvidia.com/gpu']
    }

    withLabel: 'idp' {
        // AIUPred — check if container exists, may need to build
        cpus           = 4
        memory         = '48 GB'
        time           = '2 h'
        accelerator    = [request: 1, type: 'nvidia.com/gpu']
    }

    withLabel: 'tmhmm' {
        container = 'quay.io/biocontainers/tmhmm:2.0c--pl5321h031d066_7'
        cpus      = 4
        memory    = '8 GB'
    }

    withLabel: 'targetp' {
        container = 'quay.io/biocontainers/targetp:2.0--hdfd78af_3'
        cpus      = 8
        memory    = '16 GB'
    }

    withLabel: 'wolfpsort' {
        container = 'quay.io/biocontainers/wolfpsort:0.2--hdfd78af_1'
        cpus      = 4
        memory    = '8 GB'
    }

    withLabel: 'predgpi' {
        container = 'quay.io/biocontainers/predgpi:1.1.5--pyhdfd78af_0'
        cpus      = 4
        memory    = '16 GB'
    }

    withLabel: 'merge' {
        container = 'quay.io/biocontainers/python:3.11'
        cpus      = 4
        memory    = '24 GB'
    }
}
