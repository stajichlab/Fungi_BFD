/*
 * ANI test profile: stub-run with minimal local resources.
 * Use with: -profile ani,test,test_ani --pipeline compare_ani -stub-run
 *
 * Disables singularity (stub blocks are trivial shell snippets; no real ANI
 * tool binaries are needed) and redirects every output path into tests/output/
 * so a stub-run can never write into a real project's genome_annotation/ or
 * results/ directories -- see issue #3's PR discussion for why this matters:
 * an early version of this test wiring, run without these overrides, silently
 * overwrote a real abinitio_reuse_assignments.csv via the default
 * ${launchDir}/genome_annotation publishDir target.
 */

params {
    outdir                           = "${projectDir}/tests/output/ANI"
    target                           = "${projectDir}/tests/output/ani_genome_annotation"
    gene_prediction_shared_abinitio  = "${projectDir}/tests/output/ani_genome_annotation/_shared_abinitio"
    ani_reuse_threshold              = 99.0

    // Reuse the same BUSCO_genome stub output the BFD test profile produces
    // (see conf/test.config), so a representative-selection stub-run has
    // something to read -- exercising the same genome_stats -> ani ordering
    // dependency fixed in run_funannotate_neurospora.sh.
    genome_stats_outdir               = "${projectDir}/tests/output/genome_stats"
}

apptainer.enabled   = false
singularity.enabled = false

workDir = "${projectDir}/tests/work"
