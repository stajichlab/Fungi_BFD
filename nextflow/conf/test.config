/*
 * Test profile: uses minimal synthetic data from tests/data/.
 * Run with: nextflow run nextflow/BFD.nf -profile test -stub-run
 */

params {
    samples   = "${projectDir}/tests/data/test_samples.csv"
    outdir    = "${projectDir}/tests/output/function"
    tables    = "${projectDir}/tests/output/tables"
    n_test    = 0   // test_samples.csv only has 2 rows

    // run all tools so the stub-run exercises the whole graph
    run_pfam      = true
    run_cazy      = true
    run_merops    = true
    run_signalp   = true
    run_tmhmm     = true
    run_targetp   = true
    run_idp       = true
    run_wolfpsort = true
    run_predgpi   = true
    run_swissprot = true
    run_swissprot_annot = true

    run_aa_freq    = true
    run_codon_freq = true
    run_intergenic = true
    run_gene_stats = true
    run_telomeres  = true

    pep_dir             = "${projectDir}/tests/data/input/pep"
    cds_dir             = "${projectDir}/tests/data/input/cds"
    gff_dir             = "${projectDir}/tests/data/input/gff3"
    genome_dir          = "${projectDir}/tests/data/input/dna"
    trna_dir            = "${projectDir}/tests/data/input/trna"
    genome_annotation   = "${projectDir}/tests/data/genome_annotation"

    // Setup step disabled in test/stub runs; input files are pre-staged in tests/data/
    run_setup = false

    // BFD.nf params that otherwise live only in profile_BFD.config; supplied here so
    // `-profile test` (used by run_lint.sh) can preview/stub BFD.nf standalone.
    stats_outdir        = "${projectDir}/tests/output/seqstats"
    genome_stats_outdir = "${projectDir}/tests/output/genome_stats"
    freq_batch_size     = 50
    pfam_nodes          = 1
    pfam_tasks          = 1
    run_asm_stats       = true
    run_chrom_info      = false
    run_busco_genome    = true
    run_busco_pep       = true
    busco_lineage       = 'fungi_odb12'

    // nextflow.config defaults to skip_merge=true, which would silently drop every
    // MERGE_* step from the stub graph — the half of the DAG most likely to break
    // during refactoring. Turn merges on here so `-profile test -stub-run` is a real
    // end-to-end DAG check.
    //
    // merge_all=false exercises the current-run branch, which does not depend on
    // whatever files happen to be sitting in tests/output/ from an earlier run.
    //
    // CAVEAT: this branch is NOT deterministic. MERGE_AA_FREQ / MERGE_CODON_FREQ
    // fire or don't, run to run, because their `.filter { it.exists() }` races
    // BATCH_*_FREQ's publishDir. Task counts of 44 or 45 are both expected. This
    // is a pre-existing pipeline bug, not a test-profile artifact — see
    // REFACTOR_NEXTFLOW_PLAN.md §5 item 13. The merge_all=true glob branch (the
    // production default) is not covered by this profile at all; §7 item 11.
    skip_merge          = false
    merge_all           = false
    run_build_duckdb    = true
    db                  = "${projectDir}/tests/output/db"
}

process {
    // Stub tasks are trivial shell snippets; running them locally keeps the test
    // profile self-contained and off the shared SLURM queue. Without this the
    // profile inherits the cluster executor from nextflow.config and a stub-run
    // queues ~30 real SLURM jobs to echo placeholder files.
    executor = 'local'

    // Minimal resources + no module loading for stub-run (no real tools needed).
    // beforeScript = ':' on each label overrides the main config's module loads.
    withLabel: 'setup'     { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'pfam'      { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'cazy'      { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'merops'    { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'signalp'   { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; clusterOptions = ''; beforeScript = ':' }
    withLabel: 'tmhmm'     { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'targetp'   { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'idp'       { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; clusterOptions = ''; beforeScript = ':' }
    withLabel: 'wolfpsort' { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'predgpi'   { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'swissprot' { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'genestats' { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'seqstats'  { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'merge'     { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    // asmstats/busco_* live only in profile_BFD.config, which `-profile test` does
    // not load; without these they fall through to the base config's module loads.
    withLabel: 'asmstats'     { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'busco_genome' { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'busco_pep'    { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'telomeres'    { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
    withLabel: 'duckdb'       { cpus = 1; memory = '1 GB'; time = '10 m'; queue = 'short'; beforeScript = ':' }
}

workDir = "${projectDir}/tests/work"
