/*
 * conf/profile_interproscan6_k8s.config
 *
 * Kubernetes profile for interproscan6_k8s.nf on Nautilus (National Research Platform).
 *
 * What changed vs profile_interproscan6.config:
 *   - executor: slurm → k8s
 *   - singularity → docker
 *   - /bigdata absolute paths → /workspace/... (PVC mount)
 *   - queue / clusterOptions removed (not used by k8s executor)
 *   - workDir moved to PVC so all task pods share the same work directory
 *   - Trace/report/timeline paths updated (written inside PVC)
 *
 * Before first run:
 *   1. Create PVC in your Nautilus namespace (ReadWriteMany, CephFS):
 *        kubectl apply -f k8s/pvc.yaml
 *   2. Stage IPS6 data onto the PVC (one-time, ~80 GB):
 *        kubectl run loader --image=alpine --restart=Never \
 *            --overrides='{"spec":{"volumes":[{"name":"pvc","persistentVolumeClaim":{"claimName":"stajichlab-pvc"}}],"containers":[{"name":"loader","image":"alpine","command":["sleep","7200"],"volumeMounts":[{"mountPath":"/workspace","name":"pvc"}]}]}}'
 *        kubectl cp /bigdata/stajichlab/shared/lib/interproscan6_data \
 *            loader:/workspace/lib/interproscan6_data
 *   3. Stage genome_annotation/ (or a subset) onto the PVC:
 *        kubectl cp genome_annotation/ loader:/workspace/genome_annotation/
 *   4. Stage samples.csv:
 *        kubectl cp samples.csv loader:/workspace/samples.csv
 *   5. Launch from a machine with ~/.kube/config pointing at Nautilus:
 *        nextflow run nextflow/interproscan6_k8s.nf \
 *            -c nextflow/nextflow.config \
 *            -profile interproscan6_k8s \
 *            -resume
 */

// ── Params ────────────────────────────────────────────────────────────────────
params {
    // Paths inside the PVC (all must be pre-staged; see above)
    target          = "/workspace/genome_annotation"
    ips6_datadir    = "/workspace/lib/interproscan6_data"

    // Same runtime params as HPC profile
    suppress        = "/workspace/suppress.txt"
    debug           = false
    ips6_version    = "6.0.0"             // used for documentation only on K8s (no nested NF run)
    ips6_interpro   = "latest"
    ips6_goterms    = true
    ips6_pathways   = true
    ips6_applications = ""               // empty → all applications; or e.g. "Pfam,TIGRFAM"

    // samples.csv must also be accessible from the pod
    samples         = "/workspace/samples.csv"

    // singularity_cache is ignored on K8s but kept so the HPC profile doesn't break
    // when both configs are loaded together
    singularity_cache = "/workspace/lib/singularity_cache"
}

// ── Work directory (on the shared PVC so all pods can access staged inputs) ──
workDir = "/workspace/work/interproscan6"

// ── Kubernetes executor ───────────────────────────────────────────────────────
executor {
    name            = 'k8s'
    queueSize       = 50          // max concurrent IPS6 pods; tune to your namespace quota
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '30 min'
}

k8s {
    // ── EDIT THESE for your Nautilus namespace ──────────────────────────────
    namespace        = 'ucr-stajichlab'      // kubectl get namespaces
    serviceAccount   = 'deployer'        // standard Nautilus service account
    storageClaimName = 'ucr-stajichlab-pvc'  // your ReadWriteMany PVC name
    storageMountPath = '/workspace'      // must match all /workspace paths above
    // ────────────────────────────────────────────────────────────────────────

    pullPolicy       = 'IfNotPresent'    // avoids re-pulling ~8 GB IPS6 image per pod
    launchDir        = '/workspace'      // where Nextflow writes .nextflow/ metadata

    // Pod annotations useful for Nautilus accounting (optional)
    pod = [
        [annotation: 'nrp-nautilus.io/project', value: 'stajichlab-fungi-bfd']
    ]
}

// ── Container runtime ─────────────────────────────────────────────────────────
docker {
    enabled     = true
    // Nautilus nodes run containerd; this ensures correct volume mounts inside pods
    runOptions  = '--user $(id -u):$(id -g)'
}

singularity {
    enabled = false
}

// ── Process resource requests ─────────────────────────────────────────────────
process {
    withName: 'INTERPROSCAN6_RUN' {
        container = 'docker.io/interpro/interproscan:6.0.0'
        cpus      = 16
        memory    = '64 GB'
        time      = '72h'

        // Retry on transient K8s pod eviction or OOM (exit 137)
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'finish' }
        maxRetries    = 2

        // K8s pod resource requests / limits
        // Nautilus scheduler uses these for bin-packing; request == limit avoids eviction
        resourceLimits = [
            memory: '64 GB',
            cpu:    16
        ]
    }
}

// ── Cleanup completed work dirs (saves PVC space) ────────────────────────────
// Set to false if you want -resume to work across sessions (recommended initially)
cleanup = false

// ── Trace / report / timeline (written to PVC) ───────────────────────────────
trace {
    enabled   = true
    file      = "/workspace/logs/nextflow/interproscan6_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "/workspace/logs/nextflow/interproscan6_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "/workspace/logs/nextflow/interproscan6_timeline.html"
    overwrite = true
}
