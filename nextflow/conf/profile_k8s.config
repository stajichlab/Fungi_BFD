// conf/profile_k8s.config
// Replaces Slurm executor and /bigdata paths for Nautilus

executor {
    name      = 'k8s'
    queueSize = 100
}

k8s {
    storageClaimName = 'stajichlab-pvc'   // your namespace PVC
    storageMountPath = '/workspace'
    namespace        = 'stajichlab'       // your Nautilus namespace
    serviceAccount   = 'deployer'
    pullPolicy       = 'IfNotPresent'
}

// Database paths remapped to PVC
params {
    // Mirror /bigdata/stajichlab/shared/lib → /workspace/lib on PVC
    pfam_db         = '/workspace/lib/pfam'
    merops_db       = '/workspace/lib/merops/124'
    funannotate_db  = '/workspace/lib/funannotate_db'
    ips6_datadir    = '/workspace/lib/interproscan6_data'
    taxondb         = '/workspace/lib/taxa'
    // Input/output relative to PVC
    pep_dir         = '/workspace/input/pep'
    outdir          = '/workspace/results/function'
}

docker {
    enabled = true
}
