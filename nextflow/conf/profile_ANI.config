/*
 * ANI profile: compare_ANI.nf — average nucleotide identity comparisons.
 *
 * Every identity tool runs inside a BioContainers Singularity image cached in the
 * shared Singularity cache dir (set globally in nextflow.config). No module load
 * is required for the compute tools — Singularity is the preferred path here.
 *
 * Method (--ani_method): skani (default) | mash | sourmash | fastani
 *   - sketch + compare for each sketch method share a single container/label.
 *   - per-genome sketches are cached under params.sketch_cache (storeDir).
 *
 * Container image tags are exposed as params so they can be overridden without
 * editing this file (e.g. --skani_container ...).
 *
 * Per-process cpus/memory scale with group size and are set inside the processes;
 * here we set container, time, queue and staging.
 */

singularity.enabled = true
// Bind the pipeline dir so bin/ helper scripts (report_ani.py, mash_components.py,
// sourmash_matrix_to_long.py) are reachable inside the containers by absolute path.
// (The login-shell `-l` in process.shell resets PATH inside minimal images, so we
//  call those scripts via ${projectDir}/bin/... rather than relying on PATH.)
singularity.runOptions = "--bind ${projectDir}"

workDir = "${launchDir}/work/ANI"

params {
    // BioContainers Singularity images (override on CLI if a newer build is needed)
    fastani_container  = 'https://depot.galaxyproject.org/singularity/fastani:1.34--hb66fcc3_5'
    skani_container    = 'https://depot.galaxyproject.org/singularity/skani:0.2.2--ha6fb395_2'
    mash_container     = 'https://depot.galaxyproject.org/singularity/mash:2.3--hb105d93_10'
    sourmash_container = 'https://depot.galaxyproject.org/singularity/sourmash:4.9.4--hdfd78af_0'
    // report/component scripts are pure-Python (stdlib only) → a plain python image
    report_container   = 'https://depot.galaxyproject.org/singularity/python:3.12'
}

process {

    withLabel: 'fastani' {
        // cpus/memory set dynamically in the process from group_size:
        //   <= 200 →  8 CPU / 16 GB ; <= 500 → 24 CPU / 48 GB ; > 500 → 64 CPU / 128 GB
        container      = params.fastani_container
        time           = '24 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }

    withLabel: 'skani' {
        // sketch: 2 CPU / 6 GB (short) ; triangle scales with group size
        container      = params.skani_container
        time           = '8 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }

    withLabel: 'mash' {
        container      = params.mash_container
        time           = '8 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }

    withLabel: 'sourmash' {
        // sourmash compare builds a dense NxN matrix → heavier memory for big clades
        container      = params.sourmash_container
        time           = '12 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }

    // Per-genome sketching is quick and cheap → keep it off the epyc queue.
    // (withName selectors override the withLabel queue/time above.)
    withName: '.*_SKETCH' {
        time  = '1 h'
        queue = 'short'
    }

    // Reporting / component-finding: pure-python (stdlib) in a Singularity python
    // image — no module load, so the whole pipeline is Singularity-based.
    withLabel: 'report' {
        container = params.report_container
        cpus      = 1
        memory    = '4 GB'
        time      = '2 h'
        queue     = 'short'
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_timeline.html"
    overwrite = true
}
