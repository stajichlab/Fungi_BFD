/*
 * ANI profile: compare_ANI.nf — average nucleotide identity comparisons.
 *
 * FastANI runs inside a BioContainers Singularity image cached in the shared
 * Singularity cache dir (set globally in nextflow.config).  No module load needed.
 *
 * Queue / resource defaults are tuned for the UCR HPCC cluster.
 * Override individual values with --param value or a params-file.
 */

singularity.enabled = true

workDir = "${launchDir}/work/ANI"

process {

    withLabel: 'fastani' {
        // cpus and memory are set dynamically in the process based on group_size:
        //   <= 200 genomes →  8 CPUs / 16 GB
        //   <= 500 genomes → 24 CPUs / 48 GB
        //    > 500 genomes → 64 CPUs / 128 GB
        container      = 'https://depot.galaxyproject.org/singularity/fastani:1.34--hb66fcc3_5'
        time           = '24 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }

    withLabel: 'report' {
        cpus   = 1
        memory = '4 GB'
        time   = '1 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load biopython
        """
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/ANI_timeline.html"
    overwrite = true
}
