/*
 * Container runtime selector: Apptainer (default, future-facing)
 *
 * Usage: -profile <pipeline>,apptainer
 * Example: nextflow run BFD.nf -profile BFD,apptainer
 */

apptainer.enabled = true
singularity.enabled = false

// Redundant safety net, NOT the source of truth: params.singularity_cache is
// already resolved (from the env chain, see nextflow.config) by the time this
// runs, and the apptainer{}.cacheDir block in nextflow.config is what actually
// drives the launcher's own OCI -> .sif conversion. This `env{}` block only
// injects NXF_APPTAINER_CACHEDIR into spawned SLURM task environments
// (.command.run) -- it does nothing for the launcher process itself, and it's
// normally moot because SLURM's default --export=ALL already propagates the
// launcher's real APPTAINER_CACHEDIR/NXF_APPTAINER_CACHEDIR into every task.
// Kept only in case some future submission path restricts env export; if the
// cluster's export policy ever changes, this stops being a no-op.
env {
    NXF_APPTAINER_CACHEDIR = params.singularity_cache
}
