/*
 * Container runtime selector: Singularity (legacy)
 *
 * Usage: -profile <pipeline>,singularity
 * Example: nextflow run BFD.nf -profile BFD,singularity
 *
 * Note: Singularity is deprecated in favor of Apptainer. This profile is
 * provided for backward compatibility only. New users should use the
 * apptainer profile.
 */

apptainer.enabled = false
singularity.enabled = true
