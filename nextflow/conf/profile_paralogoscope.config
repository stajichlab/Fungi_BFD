/*
 * paralogoscope profile: paralogoscope.nf — per-species WGD duplication
 * dating via wgd (Tiley et al. 2021): dmd -> ksd [+ syn].
 *
 * Inputs follow the BFD structure:
 *   input/pep/{id}.proteins.fa          (not used directly by wgd dmd)
 *   input/cds/{id}.cds-transcripts.fa   (wgd dmd + ksd source)
 *   input/gff3/{id}.gff3                (wgd syn, when --run_wgd_syn true)
 * where id = makeSampleTag(SPECIES, STRAIN), the same primary key BFD.nf uses.
 *
 * Everything runs inside the wgd container (container_wgd2_complete), so the
 * only host requirements are apptainer + squashfuse (loaded inline per task).
 *
 * Organism selection (mirrors comparative):
 *   --group  PATH  CSV with LOCUSTAG,GROUP columns
 *   --taxon  STR   Comma-separated RANK:VALUE pairs (e.g. CLASS:Sordariomycetes)
 *   --ignore PATH  One LOCUSTAG per line; excluded
 *   --n_test N     restrict to first N sample-sheet rows
 */

params {
    // Sample sheet (same LOCUSTAG/SPECIES/STRAIN/rank columns as BFD's samples.csv)
    samples   = "${launchDir}/samples.csv"

    // BFD-structure input dirs
    cds_dir   = "${launchDir}/input/cds"
    gff_dir   = "${launchDir}/input/gff3"

    // Output root: outdir/{meta.id}/wgd_dmd, .../wgd_ksd, .../wgd_syn
    outdir    = "${launchDir}/paralogoscope"

    // wgd container (built + CI-signed: ghcr.io/hyphaltip/container_wgd2_complete).
    // Materialized SIF in the shared apptainer cache (sha256 of the .sif file =
    // 9e3a9744900b...) so tasks use a local file and never pull over the network.
    // Override with another local SIF path if needed (--wgd_sif /path/to/sif).
    wgd_sif   = "${params.singularity_cache}/hyphaltip_wgd2_complete-2.0.38--9e3a9744900b_0.sif"

    // Organism selection
    group     = ''
    ignore    = ''

    // wgd dmd parameters (Tiley et al. sensitivity advice: explore e/I)
    wgd_mcl_evalue     = '1e-5'
    wgd_mcl_inflation  = 1.5

    // Filters applied when building tables/wgd.ks.parquet (raw ks.tsv is kept).
    // dS above ~5 is saturated and carries no WGD-dating signal; null-dS pairs
    // are paralog pairs wgd could not date. Set wgd_max_ds = 0 / false to keep all.
    // Gate from the 2026-10/11 evaluation (eval/sim_controls/report.md): wgd ksd --pairwise,
    // dS <= 2.5 (user choice; dS <= 2 was the evaluated cut, 2.5 raises the NG86-distant share
    // of the kept pairs by about 1.4-17 points; the 2-2.5 band is not independently validated), >= 30 per-pair codons. dS <= 5 kept 21-26% distant pairs in Rhizopus.
    // Dating method: 'pair' = bin/wgd_pair_ks.py (pair-level codeml after an identity pre-filter),
    // 'ksd_pairwise' = wgd ksd --pairwise, 'ksd' = wgd ksd default. Results go to wgd_ksd_pp /
    // wgd_ksd_pw / wgd_ksd, never mixed.
    wgd_ks_method      = 'pair'
    // Master switch for the speed-ups (pair method only): true = identity/codon pre-filter,
    // dS cut (wgd_max_ds), pair-codon gate (wgd_min_pair_codons) and null-dS drop; false = no
    // pre-filter, every pair with >= 10 aligned codons gets codeml, and the merge keeps all rows.
    // Output dir is wgd_ksd_pp_full when false. For no family-level shortcuts at all use
    // --wgd_ks_method ksd (wgd ksd default) or ksd_pairwise.
    wgd_speedups       = true
    wgd_on_error       = 'finish'   // finish | ignore | terminate (after retries)
    wgd_max_retries    = 2
    // Genomes per WGD_PAIR_KS task (sized toward 1-1.5 h; measured 1-20 min per genome in the
    // 7-genome test, so 20 is a first guess). 1 = one genome per task.
    wgd_pair_bundle    = 20
    // Collapse genes with a byte-identical CDS inside a family before pairing (dS = 0 without codeml).
    // Rows then stand for sequence pairs; copies1/copies2/npairs give the gene-pair counts. Needs wgd_speedups=true.
    wgd_collapse_identical = true
    // Genetic codes other than 1 and 12 are not validated; the genome is listed as failed
    // unless this is true (then translated with that table and codeml icode 0).
    wgd_allow_untested_table = false
    // WGD_PAIR_KS pre-filter (pairs failing it get no codeml estimate). Identity-only (no NG86 dS
    // cap, wgd_prefilter_ngds = 0) kept more gated pairs than an NG86 dS <= 3 cap at dS <= 2.5.
    wgd_prefilter_identity = 0.4
    wgd_prefilter_codons   = 30
    wgd_prefilter_ngds     = 0
    wgd_max_ds         = 2.5
    wgd_min_pair_codons = 30
    wgd_drop_null_ds   = true
    // Minimum codons left after wgd's family-wide gap stripping (strippedalignmentlength/3).
    // Set 0 / false to keep all.
    // Used only when wgd_ks_method = 'ksd' (family-level column). Under 'ksd_pairwise' and 'pair' it is a constant or unused.
    wgd_min_codons     = 0

    // Paralogoscope tables land beside the other BFD summary tables
    // (tablesDir() -> params.tables -> tables/ at the repo root).
    tables                = "${launchDir}/tables"

    // Sub-workflow switches
    run_wgd_syn        = false   // wgd syn (i-ADHoRe synteny) is heavy; opt-in

    // n_test is shared (defined in nextflow.config) — restrict to first N rows
}

workDir = "${launchDir}/work/paralogoscope"

process {
    // Failed tasks: retry wgd_max_retries times, then wgd_on_error ('finish' = stop submitting new
    // tasks, let running ones end, exit non-zero; 'ignore' = drop the task and continue, which can lose
    // a genome without stopping the run; 'terminate'). The base config default is 'ignore'. A resumed
    // run (-resume) redoes only the failed tasks. Dropped or ignored tasks are also reported by the
    // merge check (genome count) and by the workflow.onComplete summary in main.nf.
    errorStrategy = { task.attempt <= (params.wgd_max_retries as int) ? 'retry' : params.wgd_on_error }
    maxRetries    = 3
    // WGD_PAIR_KS: pair-level codeml scales with pair count; 16 CPUs is a first guess, not a measured value.
    withLabel: 'comparative_wgd_pair' {
        cpus   = 16
        memory = '32 GB'
        time   = '24 h'
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 -A preempt -p preempt --export=ALL,SCRATCH=,TMPDIR='
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
        """
    }

    withLabel: 'comparative_wgd' {
        cpus   = 8
        memory = '32 GB'
        time   = '24 h'
        // preempt partition (--account=preempt) fits within its 1-day cap and is
        // cheaper; wgd dmd/ksd are short, syn is heavier but still <24h.
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 -A preempt -p preempt --export=ALL,SCRATCH=,TMPDIR='
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
        """
    }

    // Final ks.tsv merge (MERGE_WGD_KSD) — same resources as the BFD 'merge'
    // label: miniconda3 python (pandas + pyarrow) globs all ks.tsv on disk and
    // writes tables/wgd.ks.parquet.
    withLabel: 'merge' {
        cpus         = 4
        memory       = '24 GB'
        time         = '24 h'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
        """
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/paralogoscope_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/paralogoscope_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/paralogoscope_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
