/*
 * Funannotate test profile: stub-run with minimal local resources.
 * Use with: -profile funannotate,test,test_funannotate_microsporidia -stub-run
 *
 * Overrides the SLURM executor and high CPU/memory requirements from
 * profile_funannotate.config so stub blocks run locally on a 4-CPU node.
 *
 * Also redirects params.samples/target/source/suppress away from
 * profile_funannotate.config's real-project defaults (${launchDir}/samples.csv,
 * ${launchDir}/genome_annotation, the shared NCBI_ASM source dir) into
 * tests/data|output/ -- see test_ani.config's header comment for why this
 * matters: an early version of the ANI test wiring, run without equivalent
 * overrides, silently overwrote a real abinitio_reuse_assignments.csv.
 *
 * run_sra_fetch/run_ani_reuse are forced off here: SRA_QUERY_BATCH needs real
 * network access to NCBI SRA, and the two-species/one-strain-each test fixture
 * (tests/data/funannotate/test_samples_funannotate.csv) has no multi-strain
 * species for ANI-driven representative selection to act on. This means
 * FUNANNOTATE_RNASEQ's abinitioReuseMap-driven repr_ch pick (see issue #3) is
 * NOT exercised by this stub-run -- only its "no assignment data" fallback
 * path is (repr_ch falling back to index 0, i.e. today's pre-existing
 * behavior). Exercising the representative-pick branch itself needs a
 * multi-strain fixture plus --run_sra_fetch true with mocked/cached SRA data;
 * tracked as follow-up test-fixture work, not done here.
 *
 * Microsporidia variant of test_funannotate.config (added for the
 * microsporidia Prodigal supplement plan, Task 5): same 2 non-microsporidia
 * rows as the base fixture, plus a 3rd row (GCF_TEST003, PHYLUM=Microsporidia)
 * so loadMicrosporidiaOutSet()/GENEMARK_RUN's is_microsporidia gate has
 * something to match against. Under -stub-run, GENEMARK_RUN's stub always
 * touches an empty ${out}.other.gff3 regardless of is_microsporidia -- so
 * this fixture/config only exercises DAG wiring (see task-5-brief.md Step 4),
 * not the real Prodigal-supplement gate itself.
 */

params {
    samples  = "${projectDir}/tests/data/funannotate/test_samples_funannotate_microsporidia.csv"
    source   = "${projectDir}/tests/data/funannotate/source_microsporidia"
    suppress = "${projectDir}/tests/data/funannotate/suppress.txt"
    target           = "${projectDir}/tests/output/funannotate_genome_annotation_microsporidia"
    training_target  = "${projectDir}/tests/output/funannotate_genome_annotation_training_microsporidia"

    run_sra_fetch  = false
    run_ani_reuse  = false
}

apptainer.enabled   = false
singularity.enabled = false

process {
    executor = 'local'

    withName: 'SETUP_TAXONDB'         { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'GENOME_CLEAN'          { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'GENOME_CLEAN_BATCH'    { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'MASKREPEAT_TANTAN_RUN' { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'SRA_QUERY'             { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'SRA_QUERY_BATCH'       { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'COLLECT_SRA_QUERY'     { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'WRITE_EMPTY_READS'     { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'SRA_FETCH'             { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'SRA_FETCH_SE'          { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'RNASEQ_PREPARE'        { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'FUNANNOTATE_TRAIN'     { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'FUNANNOTATE_PREDICT'   { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'GENEMARK_RUN'          { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'ANTISMASH_RUN'         { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'INTERPROSCAN_RUN'      { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'SIGNALP_RUN'           { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'FUNANNOTATE_ANNOTATE'  { cpus = 1; memory = '1 GB'; time = '5 m' }
    withName: 'FUNANNOTATE_UPDATE'    { cpus = 1; memory = '1 GB'; time = '5 m' }
}
