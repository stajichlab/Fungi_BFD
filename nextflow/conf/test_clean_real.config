/*
 * Small real-dataset test for the genome-cleaning step (GENOME_CLEAN / _BATCH)
 * running AAFTF + taxonkit from the AAFTF v0.7.0-beta.2 SIF via in-script
 * `singularity exec`.
 *
 * Real (non-synthetic) input: 3 small real fungal assemblies symlinked into
 * tests/real_clean/source/ from the 1KFG NCBI_fungi tree, covering both
 * Ascomycota (S. cerevisiae, S. pombe) and Basidiomycota (C. neoformans) so the
 * in-container taxonkit phylum-resolution path is exercised with a populated
 * lib/taxdump.
 *
 * Usage (from the nextflow/ dir, so launchDir=taxondb resolves to lib/):
 *   # 1) cheap DAG + plumbing check against the 3 real ASMIDs (no SLURM):
 *   nextflow run main.nf -c nextflow.config -c conf/test_clean_real.config \
 *       -profile funannotate --pipeline funannotate -stub-run
 *
 *   # 2) real run: SETUP_TAXONDB (real taxdump download, ~70 MB, cached to
 *   #    lib/taxdump via storeDir) + GENOME_CLEAN_BATCH on the highmem nodes,
 *   #    which stages the 465 GB FCS-GX DB into /dev/shm (~30 min) then purges
 *   #    the 3 genomes with the container (~45-60 min total wall clock):
 *   nextflow run main.nf -c nextflow.config -c conf/test_clean_real.config \
 *       -profile funannotate --pipeline funannotate -resume
 *
 * Outputs land in input_clean_genomes/<asmid>.fa (nextflow/ dir when run from
 * here), exactly like production; SETUP_TAXONDB reuses/produces lib/taxdump.
 * Until this is validated, the production AAFTF module remains in git history
 * (CAREFUL: it is NOT yet removed -- see decisions 2026-08-10).
 */

params {
    samples = "${projectDir}/tests/real_clean/samples.real_clean.csv"
    source  = "${projectDir}/tests/real_clean/source"
    clean_batch_size = 3
    only_clean = true
    // funannotate workflow hard-errors at build time if run_ani_reuse=true and the
    // compare_ANI ab-initio reuse CSV is absent. Irrelevant for the clean-only test
    // (nothing downstream runs), so turn it off.
    run_ani_reuse = false
}
