/*
 * One-off REAL (non-stub) single-genome validation config for Task 5 Step 6
 * (nextflow/docs/MICROSPORIDIA_PRODIGAL_BRANCH_PLAN.md, task-5-brief.md).
 *
 * Purpose: validate the microsporidia Prodigal-supplement gate end-to-end
 * (real GeneMark-ES + real Prodigal + real funannotate predict/EVM) against
 * *Ordospora colligata* OC4 (GCF_000803265.1_ASM80326v1, 2.29 Mb, 15
 * contigs, N50 228,601) -- the exact genome the recipe was validated on
 * (see docs/MICROSPORIDIA_PRODIGAL_BRANCH_PLAN.md and
 * ../../Microsporidia_predict/scripts/run_microsporidia_predict.py).
 *
 * Deliberately separate from the real production samples.csv/source/
 * input_clean_genomes -- those may be actively read by an unrelated,
 * currently-running production job. This config points samples/source at
 * one-off fixture files under tests/data/funannotate/ instead.
 *
 * Unlike test_funannotate.config / test_funannotate_microsporidia.config,
 * this is NOT a -stub-run config: it keeps profile_funannotate.config's
 * real SLURM executor/resource directives (queue=preempt, escalating
 * memory/time on GENEMARK_RUN/FUNANNOTATE_PREDICT, etc.) and real
 * apptainer containers, so `nextflow run ... -profile funannotate
 * --pipeline funannotate --asmid GCF_000803265.1_ASM80326v1` (no
 * -stub-run) submits real SLURM jobs.
 *
 * run_repeatmasker = false: input_clean_genomes/GCF_000803265.1_ASM80326v1
 * .masked.fasta.gz is a direct copy of the ALREADY-MASKED genome the
 * recipe was validated against (copied from
 * ../../Microsporidia_predict/input_clean_genomes/), staged so
 * FUNANNOTATE_GENOME_PREP's "use masked genome if a prior run produced
 * it" fallback path feeds funannotate predict the exact same masked
 * sequence as the validated reference run, rather than a fresh tantan
 * re-mask that could differ in soft-masked spans. A same-named
 * GCF_000803265.1_ASM80326v1.fa.gz (same bytes) is also staged so
 * FUNANNOTATE_GENOME_PREP's jobs_to_clean filter sees this genome as
 * already-cleaned and skips the expensive real GENOME_CLEAN_BATCH
 * (FCS-GX decontamination) step entirely -- its content is never read
 * once the masked genome fallback fires.
 *
 * run_sra_fetch/run_ani_reuse forced off: no RNA-seq for this genome, and
 * a single-genome/single-strain run has nothing for ANI-driven
 * representative selection to act on.
 *
 * run_genemark explicitly true (matches profile default): this validates
 * GeneMark-ES and Prodigal running together via --other_gff, per the
 * plan's explicit "do not skip GeneMark" constraint -- not a
 * GeneMark-free variant.
 */

params {
    samples  = "${projectDir}/tests/data/funannotate/samples_oc4_validation.csv"
    source   = "${projectDir}/tests/data/funannotate/source_oc4_validation"
    target           = "${projectDir}/tests/output/oc4_validation/genome_annotation"
    training_target  = "${projectDir}/tests/output/oc4_validation/genome_annotation_training"

    run_sra_fetch     = false
    run_ani_reuse     = false
    run_genemark      = true
    run_repeatmasker  = false

    // funannotate predict does an unconditional --busco_db existence check at
    // startup (independent of whether BUSCO ends up actually invoked --
    // confirmed empirically: "ERROR: microsporidia_odb10 busco database is not
    // found, install with funannotate setup -b microsporidia_odb10" fired even
    // with augustus/snap weight 0, which per FUNANNOTATE_PREDICT/main.nf's own
    // comment should make RunBusco never True). The real shared funannotate_db's
    // busco lineages (e.g. microsporidia_odb10) are themselves symlinks to
    // /srv/projects/db/BUSCO/v10/lineages/<lineage> -- FUNANNOTATE_PREDICT's
    // SING_BINDS only binds funannotate_db's own top-level path, not that symlink
    // target, so the container sees a dangling symlink inside apptainer. This is
    // a latent, lineage-agnostic gap (every one of funannotate_db's 167 lineages
    // is a /srv symlink, not specific to microsporidia) -- out of scope to fix in
    // the shared module for this one-off validation. A Nextflow process-level
    // `containerOptions` bind has NO effect here (confirmed empirically): this
    // module hand-builds its own `apptainer exec` from a bash-level SING_BINDS
    // variable rather than using Nextflow's container-directive integration, so
    // extra binds can't be injected from outside the module.
    //
    // Fix: override funannotate_db to a private directory
    // (tests/output/oc4_validation/funannotate_db_private/, gitignored/disposable)
    // containing a REAL, materialized copy (rsync -aL, not symlinked) of only
    // microsporidia_odb10 (441 MB). Sufficient because, per the predict.py trace
    // above, `funannotate predict` with augustus/snap/glimmerhmm weight 0 needs
    // the named --busco_db lineage only for its startup existence check and never
    // actually invokes BUSCO or reads any other funannotate_db content (pfam/
    // uniprot/merops are `funannotate annotate`-only, and run_annotate=false
    // here). If a later run of this config needs more funannotate_db content,
    // add it under this same private directory rather than pointing back at the
    // real shared one (whose other 166 lineages have the identical /srv-symlink
    // problem).
    funannotate_db = "${projectDir}/tests/output/oc4_validation/funannotate_db_private"
}
