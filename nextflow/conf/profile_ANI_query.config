/*
 * query_ANI overrides, layered on top of profile_ANI.config.
 *
 * query_ANI groups one rank BROADER than compare_ANI does: it searches genomes
 * missing --query_rank (GENUS) against the rest of their --compare group
 * (CLASS). compare_ANI's default of --compare GENUS would leave nothing to
 * search against, which is the only parameter the two workflows genuinely
 * disagree on — hence a separate profile rather than a shared default.
 *
 * Usage:
 *   nextflow run nextflow/main.nf -entry QUERY_ANI \
 *       -c nextflow/nextflow.config -profile ani_query -resume
 */

params {
    compare = 'CLASS'
}
