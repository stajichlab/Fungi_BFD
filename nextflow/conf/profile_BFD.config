/*
 * BFD profile: BFD.nf (functional annotation) and
 * genome_seqstats.nf (sequence statistics) for annotated BFD genomes.
 */

params {
    pep_dir             = "${launchDir}/input/pep"
    cds_dir             = "${launchDir}/input/cds"
    gff_dir             = "${launchDir}/input/gff3"
    trna_dir            = "${launchDir}/input/trna"
    genome_dir          = "${launchDir}/input/dna"
    // Raw/clean assemblies (<asmid>.fa.gz). asm_stats falls back here for genomes
    // with no predict_results scaffolds (predict skipped them), flagged unannotated.
    clean_genome_dir    = "${launchDir}/../input_clean_genomes"
    genome_annotation   = "${launchDir}/genome_annotation"
    tables              = "${launchDir}/tables"
    // NOTE: there is deliberately no `scripts` param. Helper scripts are pipeline
    // code, not per-run data, so modules call them as ${projectDir}/bin/<script>
    // directly — see the comment on process.shell in nextflow.config for why we
    // don't rely on Nextflow's auto-staged bin/ on PATH.
    outdir              = "${launchDir}/results/function"
    stats_outdir        = "${launchDir}/results/seqstats"
    genome_stats_outdir = "${launchDir}/results/genome_stats"

    run_setup     = true
    run_pfam      = true
    run_cazy      = true
    run_merops    = true
    run_swissprot = true
    // Build the SwissProt accession -> annotation table (swissprot_annot.parquet).
    run_swissprot_annot = true
    run_signalp   = true
    run_tmhmm     = true
    // TargetP 2.0 is replaced by DeepLoc 2.1 (run_deeploc, below). TargetP
    // stays available (run_targetp: true) and its existing results still merge.
    run_targetp   = false
    run_idp       = true
    run_wolfpsort = true
    run_predgpi   = true

    // ── New functional-annotation tools (2026-08-20 followup) ────────────────
    // Off by default (opt-in via --run_<tool> true), same as run_busco_*:
    // several of these are new/unvalidated on a real genome (see the module
    // comments under nextflow/modules/BFD/) and shouldn't silently join every
    // production run until confirmed working.
    run_eggnog    = false
    run_phobius   = false
    run_deeptmhmm = false
    // DeepLoc 2.1 (replaces TargetP). Opt-in until a full GPU run is checked.
    run_deeploc   = false
    run_tcdb      = false
    run_tf        = false
    run_antismash = false
    run_trnascan  = false
    run_infernal  = false
    run_cazy_cgc  = false

    // eggnog-mapper: reuses funannotate's already-staged eggNOG data dir
    // (profile_funannotate.config's params.eggnog_data_dir) rather than a
    // second BFD-local copy.
    eggnog_data_dir = "/srv/projects/db/eggNOG/LATEST"
    eggnog_sif      = "docker://quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0"

    // DeepTMHMM: reuses the prebuilt academic-license SIF already used by
    // ~/projects/nf/nf_funannotate1's DEEPTMHMM_ANNOTATION -- no second
    // image/license copy.
    deeptmhmm_sif = "${params.singularity_cache}/DeepTMHMM-1.0.sif"
    deeptmhmm_gpu = false
    // 'predict.py' (stock) or 'predict_fast.py' (needs the private
    // DeepTMHMM-1.0-fast.sif). deeptmhmm_topo_batch applies to predict_fast.py
    // only: 1 matches predict.py exactly; 16 was 4.5x faster on GPU and changed
    // residue labels for 0.66% of 9,789 proteins (2026-11-05).
    deeptmhmm_script     = 'predict.py'
    deeptmhmm_topo_batch = 1

    // DeepLoc 2.1: lab-built SIF with both model backbones baked in
    // (~/projects/containers/deeploc_container, deeploc-2.1.def). Licensed
    // (DTU academic) -- keep the SIF in lab storage only.
    // deeploc_model: Fast (ESM1b) or Accurate (ProtT5). Output files carry the
    // model name, so switching models re-runs instead of reusing cached files.
    // deeploc_gpu: benchmark 2026-11-04 on a 12,794-protein proteome: GPU (RTX
    // 6000 Ada) 524 s incl. model load; CPU Fast ~2 s/protein on 16 epyc cores
    // (~7 h). So GPU is the default.
    deeploc_sif   = "${params.singularity_cache}/deeploc-2.1.sif"
    deeploc_model = 'Fast'
    deeploc_gpu   = true

    // TCDB (transporter classification): SETUP_TCDB_DB downloads tcdb.fasta
    // from tcdb.org and builds a BLAST db here once (storeDir-cached).
    tcdb_dbdir  = "${launchDir}/lib/tcdb"
    tcdb_evalue = 1e-10

    // antiSMASH: reuses the already-populated shared DB (9.6 GB, confirmed
    // 2026-08-20) and prebuilt SIF -- no download/build step needed.
    antismash_dbdir = "/bigdata/stajichlab/shared/lib/antismash_db"
    // Named distinctly from funannotate's antismash_sif (a different, free
    // bioconda image paired with a different DB) -- the two are NOT
    // interchangeable, see profile_funannotate.config's antismash_sif comment.
    antismash_standalone_sif = "${params.singularity_cache}/antismash-standalone-8.0.4.sif"
    antismash_taxon = "fungi"

    // tRNAscan-SE + Infernal/Rfam: containerized per the "less HPCC-dependent"
    // direction. Rfam 14.5 (cmpress'd) is already shared at
    // /srv/projects/db/rfam/14.5 -- no download step needed.
    trnascan_sif = "docker://quay.io/biocontainers/trnascan-se:2.0.13--pl5321hab16a5f_0"
    // Pinned: 1.1.5 has the same digest as the :latest this used before
    // (sha256:9d10dc8c..., checked on Docker Hub 2026-10-30).
    infernal_sif = "docker://rnacentral/infernal:1.1.5"
    rfam_dbdir   = "/srv/projects/db/rfam/14.5"

    // dbCAN CGC/PUL (item #7): full run_dbcan (not dbcanlight, which has no
    // cgc mode). SETUP_DBCAN_DB downloads the full run_dbcan reference DB set
    // here once (storeDir-cached) -- distinct from and larger than
    // dbcanlight's own HMM set RUN_CAZY already uses.
    //
    // docker://haidyi/run_dbcan:latest (the originally-suggested image) turned
    // out to be dbCAN 4.1.4, which has no `easy_CGC`/`database` subcommands at
    // all (confirmed via `run_dbcan --help` against the real pulled image,
    // 2026-08-20) -- that CLI is a single positional `inputFile
    // {protein,prok,meta}` with a `--cluster` flag instead. Switched to
    // dbCAN 5.2.9 (quay.io/biocontainers/dbcan), the exact version
    // nf-core/funcscan's rundbcan/easycgc and rundbcan/database modules pin
    // and the source the `--input_raw_data/--mode/--db_dir/--input_gff/
    // --gff_type/--output_dir` flags below were verified against directly
    // (`run_dbcan easy_CGC --help` on the pulled image).
    dbcan_cgc_sif = "docker://quay.io/biocontainers/dbcan:5.2.9--pyhdfd78af_0"
    dbcan_dbdir   = "${launchDir}/lib/dbcan_db"
    // Local CAZyDB release linked into dbcan_dbdir by SETUP_DBCAN_DB instead of
    // downloading it (CAZy.dmnd, dbCAN.hmm, dbCAN_sub.hmm, substrate map).
    // Tested 2026-11-06: the v14.0 .dmnd works with the container's DIAMOND
    // 2.2.0, and dbCAN.hmm loads in pyhmmer. v14.0 holds dbCAN_sub.hmm and the
    // substrate map only as links to v13.0. Set to "" to download everything.
    dbcan_cazy_src = "/srv/projects/db/CAZY/CAZyDB/v14.0"

    pfam_nodes    = 1
    pfam_tasks    = 1

    run_aa_freq    = true
    run_codon_freq = true
    freq_batch_size = 50
    run_intergenic = true
    run_gene_stats = true
    run_asm_stats  = true
    run_chrom_info = true
    run_telomeres  = true

    // Telomere finder parameters.
    // Defaults include the common fungal variant repeats from TeloBase; override
    // with --telomere_patterns to search a custom set.
    telomere_patterns      = ['TTAGGG', 'TCAGGG', 'TTGGGG', 'CCCTAA', 'CCCTGA',
                              'CCCCAA', 'TTAGGGTCAACA', 'TTATTAGGG', 'TTTATTAGGG',
                              'TTATTGGGG', 'TTATTGGGTTT', 'TTATTGGGTGT', 'TTAGGGTTTGGT',
                              'TTAGG', 'CCC[C]+TAA']
    telomere_min_repeats   = 3
    telomere_min_length    = 36
    telomere_flank_window  = 500
    telomere_search_window = 5000
    telomere_fuzzy         = false
    telomere_max_mismatch  = 1
    telomere_max_indel     = 0
    // Search every pattern in both orientations at both scaffold ends. Patterns
    // below are written in mixed C-strand / G-strand form, so this must stay true.
    telomere_both_ends     = true
    telomere_allow_internal = false
    telomere_terminal_tolerance = 10
    // Batched step: ~36 s per genome on average (232-genome stratified sample),
    // so 100 genomes is about 1 h per task. Fragmented assemblies are slower.
    telomere_batch_size    = 100
    // De novo terminal tandem-repeat finder (bin/denovo_telomere_repeats.py).
    telomere_denovo_window     = 2000
    telomere_denovo_tolerance  = 50
    telomere_denovo_purity     = 0.85
    telomere_denovo_min_length = 60
    telomere_denovo_background = 300
    telomere_denovo_min_ends   = 2
    telomere_denovo_args       = ''

    // BUSCO genome- and protein-mode completeness assessment.
    // Default lineage is fungi_odb12; override with --busco_lineage on the
    // command line to use a finer-grained set (e.g. ascomycota_odb12).
    // Both steps are off by default because of their cost at 5K+ species scale.
    run_busco_genome = false
    run_busco_pep    = false
    busco_lineage    = 'fungi_odb12'
    busco_lineages_dir = '/srv/projects/db/BUSCO/v12/'

    // Merge scope and skip controls.
    // merge_all=true  → MERGE collects ALL files from results/function/<tool>/,
    //                   not just those produced in this run (default).
    // merge_all=false → MERGE only sees outputs from the current run.
    // skip_merge=true → skip all MERGE_* steps (useful when only running new
    //                   species and deferring the merge to a later step).
    merge_all  = false
    skip_merge = true
}

// ── Container runtime ────────────────────────────────────────────────────────
// BFD container tools run in Apptainer (if -profile apptainer is used).
// All container images (docker://, .sif files) are compatible with both
// Singularity and Apptainer. Enable Apptainer by default for this pipeline:
apptainer.enabled = true
singularity.enabled = false

workDir = "${launchDir}/work/BFD"

process {
    withLabel: 'setup' {
        cpus   = 2
        memory = '1 GB'
        time   = '2 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
        """
    }

    withLabel: 'pfam' {
        cpus           = 4
        memory         = '16 GB'
        time           = '8 h'
        queue          = 'highclock'
        // `cpus = 4` already emits `#SBATCH -c 4`; do NOT also set -c in
        // clusterOptions or the two directives collide (last one wins) and the
        // job is starved to 1 core while `hmmsearch --cpu ${task.cpus}` runs 4
        // threads. clusterOptions only pins node/task layout.
        clusterOptions = { params.pfam_tasks > 1
                            ? "-N ${params.pfam_nodes} -n ${params.pfam_tasks}"
                            : '-N 1 -n 1' }
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            if [ ${params.pfam_tasks} -gt 1 ]; then
                module load hmmer/3.4-mpi
            else
                module load hmmer/3.4
            fi
            module load db-pfam
            module load workspace/scratch
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'cazy' {
        cpus         = 16
        memory       = { task.attempt == 1 ? '4GB' : '8GB' }
        time         = '2 h'
        queue        = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load dbcanlight
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'merops' {
        cpus   = 1
        memory = '1 GB'
        time   = '2 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load db-merops/124
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'swissprot' {
        cpus   = 8
        memory = '16 GB'
        time   = '8 h'
        queue  = 'stajichlab'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'signalp' {
        cpus           = 1 
        memory         = '24 GB'
        time           = '2 h'
        queue          = 'short_gpu'
        clusterOptions = '-N 1 -n 1 --gres=gpu:1'
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load signalp/6-gpu
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'tmhmm' {
        cpus   = 4
        memory = '8 GB'
        time   = '2 h'
        queue  = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load tmhmm
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'targetp' {
        cpus   = 8
        memory = '16 GB'
        time   = '4 h'
        queue  = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load targetp
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'idp' {
        cpus           = 4
        memory         = '48 GB'
        time           = '2 h'
        queue          = 'short_gpu'
        // aiupred's torch build (2.6.0+cu124) only ships kernels for sm_50-sm_90;
        // exclude K80 (sm_37, too old) and Blackwell6000 (sm_120, too new) nodes,
        // which fail with "no kernel image is available for execution on the device"
        clusterOptions = '-N 1 -n 1 -c 1 --gres=gpu:1 --exclude=gpu01,gpu02,gpu03,gpu13,gpu14'
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load aiupred
            module load biopython
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'wolfpsort' {
        cpus   = 1
        memory = '1 GB'
        time   = '2 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load wolfpsort
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'predgpi' {
        cpus         = 4
        memory       = '16 GB'
        time         = '4 h'
        queue        = 'epyc'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load predgpi
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    // ── New functional-annotation tools (2026-08-20 followup) ────────────────
    withLabel: 'eggnog' {
        cpus   = 8
        memory = '32 GB'
        time   = '4 h'
        queue  = 'epyc'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'phobius' {
        cpus   = 1
        memory = '2 GB'
        time   = '2 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load phobius
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'deeptmhmm' {
        cpus           = { params.deeptmhmm_gpu ? 4 : 16 }
        memory         = { params.deeptmhmm_gpu ? '16 GB' : '32 GB' }
        time           = '2 h'
        queue          = { params.deeptmhmm_gpu ? 'short_gpu' : 'epyc' }
        clusterOptions = { params.deeptmhmm_gpu ? '-N 1 -n 1 --gres=gpu:1' : '-N 1 -n 1' }
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'deeploc' {
        // torch 2.9.0+cu128 in the SIF. Verified on A100 (sm_80) 2026-10-22 and
        // RTX 6000 Ada (sm_89) 2026-11-04. Same node exclusions as 'idp' (K80 too
        // old; Blackwell untested). Measured: 524 s/proteome on GPU, host RSS
        // 10.5 GiB (ESM1b is loaded in host RAM first), so 32 GB is ample.
        cpus           = { params.deeploc_gpu ? 4 : 16 }
        memory         = { params.deeploc_gpu ? '32 GB' : '32 GB' }
        time           = { params.deeploc_gpu ? '2 h' : '24 h' }
        queue          = { params.deeploc_gpu ? 'short_gpu' : 'epyc' }
        clusterOptions = { params.deeploc_gpu ? '-N 1 -n 1 --gres=gpu:1 --exclude=gpu01,gpu02,gpu03,gpu13,gpu14' : '-N 1 -n 1' }
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    // 'short' allows at most 2 h (scontrol show partition short, 2026-11-06),
    // so a 4 h request there is rejected by sbatch ("Requested time limit is
    // invalid"). tcdb, cazy_cgc and SETUP_DBCAN_DB use 'batch' for that reason.
    withLabel: 'tcdb' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
        queue  = 'batch'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'antismash' {
        cpus   = 8
        memory = '24 GB'
        time   = '8 h'
        queue  = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'trnascan' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'infernal' {
        cpus   = 16
        memory = '16 GB'
        time   = '12 h'
        queue  = 'epyc'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'cazy_cgc' {
        cpus   = 8
        memory = '16 GB'
        time   = '4 h'
        queue  = 'batch'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'genestats' {
        cpus         = 1
        memory       = '8 GB'
        time         = '2 h'
        queue        = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load biopython
            module load bedtools/2.30.0
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'asmstats' {
        cpus         = 1
        memory       = '4 GB'
        time         = '1 h'
        queue        = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    // Batched task (telomere_batch_size genomes, about 1 h on average). Fragmented
    // assemblies run much longer, and the short queue caps at 2 h, so use epyc
    // (30-day limit). The batch partition had no usable nodes on 2026-11-12.
    withLabel: 'telomeres' {
        cpus         = 1
        memory       = '4 GB'
        time         = '4 h'
        queue        = 'epyc'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load biopython
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    // SETUP_DBCAN_DB's full run_dbcan reference set is much larger than
    // SETUP_TCDB_DB's single tcdb.fasta -- give it more time/memory than the
    // shared 'setup' label default.
    withName: 'SETUP_DBCAN_DB' {
        queue  = 'batch'
        memory = '8 GB'
        time   = '4 h'
        cpus   = 2
    }

    // Per-genome stat processes: tune individually where needed.
    withName: 'CALC_INTERGENIC' {
        memory = '16 GB'
        time   = '1 h'
    }
    withName: 'CALC_GENE_STATS' {
        cpus   = 2
        memory = '16 GB'
        time   = '2 h'
    }

    withLabel: 'busco_genome' {
        errorStrategy  = 'retry'
	maxRetries     = 3
        cpus           = { task.attempt == 1 ? 8 : 16 }
        // Memory scales with genome size (miniprot index in BUSCO 6.1). Measured
        // 2026-11-01 over ~10,500 jobs: <=565 Mb ran in 4 GB (501 Mb OOM at 4 GB);
        // 748 and 1057 Mb needed >4 GB, ran in 8 GB; 1274 Mb OOM at 8 GB, peak RSS
        // 12.2 GB (96 GB runs); 1489 Mb OOM at 8 GB. Gzipped input is ~3x smaller
        // on disk than the bases, so scale it back up. Retry doubles, then 96 GB.
        memory         = {
            def bases = genome.size() * (genome.name.endsWith('.gz') ? 3 : 1)
            def base_gb = bases < 400_000_000 ? 4 : bases < 1_100_000_000 ? 8 : 24
            task.attempt == 1 ? base_gb.GB : task.attempt == 2 ? (base_gb * 2).GB : 96.GB
        }
        time           = { task.attempt == 1 ? '2 h' : '6 h'}
        // Attempt 1 runs on preempt (median 33 min, p90 42 min). A retry leaves
        // preempt for the default queue, so it drops the preempt account too.
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1 --account=preempt' : '' }
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
    	    module load miniconda3
    	    eval "\$(conda shell.bash hook)"
    	    module load busco
            module load workspace/scratch
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'busco_pep' {
        cpus           = 4
        memory         = '2 GB'
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        beforeScript   = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
    	    module load miniconda3
    	    eval "\$(conda shell.bash hook)"
            module load busco
            module load workspace/scratch
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'seqstats' {
        cpus         = 2
        memory       = '8 GB'
        time         = '2 h'
        queue        = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load biopython
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    withLabel: 'merge' {
        cpus         = 4
        memory       = '24 GB'
        time         = '24 h'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            export CONDA_NO_PLUGINS=true
            module load miniconda3
            eval "\$(conda shell.bash hook)"
            module load biopython
            export PATH="${projectDir}/bin:\${PATH}"
        """
    }

    // Matches bin/build_BFD_duckDB.sh's own #SBATCH header (-p short --mem 64gb
    // -c 16). No beforeScript module load needed: the script already loads
    // duckdb inline as its first command (repo convention -- beforeScript module
    // loads don't reliably survive to script:, see CLAUDE.md).
    withLabel: 'duckdb' {
        cpus   = 16
        memory = '64 GB'
        time   = '2 h'
        queue  = 'short'
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/BFD_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/BFD_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/BFD_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
