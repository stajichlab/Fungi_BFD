/*
 * funannotate profile: funannotate.nf genome prediction and annotation pipeline.
 *
 * SOURCE: /bigdata/stajichlab/shared/projects/1KFG/common_annotate/pipeline/nextflow/nextflow.config (funannotate profile)
 *         /bigdata/stajichlab/shared/projects/1KFG/common_annotate/pipeline/nextflow/funannotate.nf (params block)
 * Last synced: 2026-05-23
 * Changes vs source: params extracted from funannotate.nf and merged here;
 *                    workDir/cleanup/trace/report/timeline lifted from profile block.
 */

singularity.enabled = true
// ANI_REPRESENTATIVE_SELECT needs pip cache + python_packages for DuckDB install.
// Singularity hard-FATALs ("mount source ... doesn't exist") if a bind source
// path is missing, and the bind is applied when the first task's container
// launches — before any process body can run. The dirs are created in
// main.nf (script-parse time, not config), since neither a bare top-level
// expression nor a params{} entry survives Nextflow's config validators
// cleanly -- see the _bindSourceDirs comment there.
singularity.runOptions = "--bind ${projectDir},${launchDir}/work/ANI/pip_cache:/root/.cache/pip,${launchDir}/work/ANI/python_packages:/tmp/python_packages"

params {
    target               = "${launchDir}/genome_annotation"
    training_target      = "${launchDir}/genome_annotation_training"
    // taxondb intentionally not overridden here -- nextflow.config's default
    // (${launchDir}/lib/taxdump) is auto-provisioned by SETUP_TAXONDB.
    proteins             = "${launchDir}/lib/swissprot_fungi.faa"
    source               = "/bigdata/stajichlab/shared/projects/1KFG/2026/NCBI_fungi/source/NCBI_ASM"
    seqcenter            = "NCBI"
    augustus_config      = "${launchDir}/lib/augustus/3.5/config"
    funannotate_db       = "/bigdata/stajichlab/shared/lib/funannotate_db"
    min_contig_len       = 2000
    // Cleaned assemblies below this total length (bp) are almost certainly junk/
    // contamination-only or a failed FCS-GX purge, not a usable genome. Their asmid is
    // logged to TO_ADD_TO_SUPRESS.csv instead of being fed downstream.
    min_assembly_len     = 1000000
    // Helper scripts are pipeline code, so they resolve against projectDir
    // (works regardless of launchDir/cwd, and when pulled from GitHub).
    clean_script         = "${projectDir}/bin/clean_genome_fa.py"
    fastq_hdr_script     = "${projectDir}/bin/fix_fastq_header_trinity"
    sbt_template         = "${launchDir}/lib/template.sbt"
    debug                = false
    max_cpus             = 64
    suppress             = "suppress.txt"
    max_rnaseq_runs      = 2
    max_rnaseq_spot	 = 0
    max_rnaseq_reads     = 40000000
    enable_single_end    = true
    max_rnaseq_se_runs   = 3
    only_clean           = false
    // Genome cleaning batching: group this many genomes per SLURM job so the FCS-GX DB
    // is staged into /dev/shm once per batch (~30 min) instead of once per genome.
    // Set to 0 to revert to one SLURM job per genome (GENOME_CLEAN).
    clean_batch_size     = 1000
    stop_after_sra_fetch  = false
    stop_after_sra_query  = false
    skip_sra_query        = false   // true = read existing rnaseq_reads/sra_query/*.sra_query.csv directly; skip all SRA_QUERY_BATCH jobs
    run_sra_fetch         = true
    sra_query_batch_size  = 10
    run_repeatmasker     = true
    run_update           = false
    run_annotate         = false
    run_antismash        = false
    rnaseq_data          = "${launchDir}/rnaseq_data"
    run_interpro         = false
    run_signalp          = false
    antismash_taxon      = "fungi"
    pasa_mysql           = true
    rnaseq_trimmer       = "fastp"
    mariadb_sif          = "/bigdata/stajichlab/shared/lib/mariadb/mariadb.sif"
    mysql_datadir        = "/bigdata/stajichlab/jstajich/mysql/db"
    pasa_conf_dir        = "/rhome/jstajich/.pasa/pasa_conf/"
    max_intronlen        = 3000
    min_intronlen        = 10
    // ── Too-small-genome guard (FUNANNOTATE_PREDICT pre-flight) ───────────────
    // funannotate predict aborts with "Not enough gene models N to train Augustus
    // (30 required), exiting" when an assembly is too small/fragmented to yield a
    // training set. Empirically (analysis/funannotate_model_failures/) every such
    // failure had assembled span < ~16 Mb AND was fragmented; large genomes never
    // failed this way. This pre-flight gate is deliberately CONSERVATIVE: it skips
    // only assemblies that trip BOTH gates (small AND fragmented), so it never
    // false-skips a complete small genome (e.g. Malassezia ~7-9 Mb, N50 >1 Mb,
    // <50 contigs passes). At 8 Mb it catches the obvious sub-8 Mb junk up front
    // (saving hours of GeneMark/BUSCO compute); the post-predict catch below is the
    // backstop that converts any 8-16 Mb fragmented genome funannotate itself
    // rejects into a clean skip instead of a crash.
    // Set predict_min_asm_bp = 0 to disable the pre-flight guard entirely.
    predict_min_asm_bp        = 8000000    // assembled bp below this = "small"
    predict_frag_max_n50      = 10000      // N50 below this = "fragmented"
    predict_frag_max_contigs  = 1000       // contig count above this = "fragmented"

    // Species-level ab-initio parameter reuse (todo/species_level_abinitio_reuse.md).
    // Computed inline by ANI_REPRESENTATIVE_SELECT (grafted before predict) when
    // --run_ani_reuse=true; falls back to all-train-independently if ANI data
    // is unavailable or --run_ani_reuse=false.
    share_abinitio_params            = true   // enabled by default when ANI is available
    abinitio_reuse_csv               = "${launchDir}/genome_annotation/_reuse_assignments/abinitio_reuse_assignments.csv"
    // launchDir-relative so each project tree finds its own store. Was hardcoded to
    // .../Fungi_BFD/gene_prediction_shared_abinitio, which no longer exists (the store
    // moved to Fungi_BFD_runs/) -- sharedParamsJsonFor() was therefore returning null
    // for every species and silently disabling ab-initio reuse entirely.
    gene_prediction_shared_abinitio  = "${launchDir}/gene_prediction_shared_abinitio"
    force_independent_species        = ""
    run_ani_reuse                    = true   // compute ANI for representative selection
    ani_reuse_threshold              = 99.0   // ANI%% to representative for reuse_eligible

    // FUNANNOTATE_PREDICTION.nf --predict_scope:
    //   representative_only — predict only is_representative strains (auto-derived
    //     from abinitio_reuse_assignments.csv), then backfill the shared store.
    //     Composes with --taxon/--asmid/--n_test as usual.
    //   all (default) — everyone, gated: an eligible non-representative sibling only
    //     predicts once its species' shared ab-initio params are available (pre-
    //     existing on disk, or freshly backfilled by this same run's representative).
    //     Species with neither get their eligible siblings excluded and reported to
    //     predict_blocked_awaiting_representative.tsv, unless allow_independent_fallback.
    predict_scope                    = 'all'
    allow_independent_fallback       = false

    // GENEMARK_RUN (nextflow/docs/GENEMARK_RUN_DESIGN.md): standalone GeneMark
    // step ahead of FUNANNOTATE_PREDICT, so predict can move onto the rust
    // container (GeneMark can't be containerized -- license). false falls
    // back to predict's own --auto-skip-genemark degradation, unchanged.
    run_genemark                     = true
    genemark_mode                    = 'ES'   // ET scoped, not implemented yet
    genemark_force_independent_strains = ''

    // ANI params needed by ANI_REPRESENTATIVE_SELECT (defaults match profile_ANI.config).
    ani_method                       = 'skani'
    compare                          = 'GENUS'
    outdir                           = "${launchDir}/results/ANI"
    genome_dir                       = "${launchDir}/input_clean_genomes"
    busco_genome_dir                 = "${launchDir}/results/genome_stats/BUSCO_genome"
    skani_preset                     = 'medium'
    skani_min_af                     = 15
    skani_compression                = 0
    mash_kmer                        = 21
    mash_sketch_size                 = 10000
    sourmash_kmer                    = 21
    sourmash_scaled                  = 1000
    fastani_fraglen                  = 3000
    fastani_kmer                     = 16
    sketch_cache                     = "${launchDir}/work/ANI/sketch_cache"
}

workDir = "${launchDir}/work/funannotate"
cleanup = true

process {
    withName: 'SETUP_TAXONDB' {
        queue  = 'short'
        memory = '1 GB'
        time   = '30m'
        cpus   = 1
    }
    withName: 'GENOME_CLEAN' {
        queue          = 'highmem'
        memory         = '500 GB'
        time           = '2h'
        clusterOptions = '-N 1 -n 1 -w h04,h05,h06'
    }
    withName: 'GENOME_CLEAN_BATCH' {
        queue          = 'highmem'
        cpus           = 16
        memory         = '500 GB'
        time           = '7d'
        // Pinned to the 3 highmem nodes; each batch holds the FCS-GX DB in /dev/shm.
        // maxForks = 1 runs one batch at a time (raise toward 3 to use all pinned nodes).
        maxForks       = 2
        clusterOptions = '-N 1 -n 1 -w h04,h05,h06'
    }
    withName: 'SRA_QUERY_BATCH' {
        errorStrategy = 'retry'
        maxRetries    = 2
        maxForks      = 10
        queue         = 'short'
        memory        = '512 MB'
        time          = '2h'
        cpus          = 1
    }
    withName: 'COLLECT_SRA_QUERY' {
        queue  = 'short'
        memory = '256 MB'
        time   = '20m'
        cpus   = 1
    }
    withName: 'WRITE_EMPTY_READS' {
        queue  = 'short'
        memory = '256 MB'
        time   = '5m'
        cpus   = 1
    }
    withName: 'SRA_FETCH' {
        errorStrategy = 'retry'
        maxRetries    = 3
        queue         = { task.attempt == 1 ? 'short' : 'epyc' }
        memory        = { task.attempt == 1 ? '48 GB' : '192 GB' }
        time          = { task.attempt == 1 ? '2h' : task.attempt == 2 ? '8h' : task.attempt == 3 ? '24h' : '48h' }
        cpus          = 32
    }
    withName: 'SRA_FETCH_SE' {
        errorStrategy  = 'retry'
        maxRetries     = 3
        // Non-'short' retries fit within preempt's 1-day cap (max 24h here), so
        // route them to the preempt account/partition for cheaper throughput.
        queue          = { task.attempt == 1 ? 'short' : 'preempt' }
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1' : '-N 1 -n 1 --account=preempt' }
        memory         = { task.attempt == 1 ? '48 GB' : '192 GB' }
        time           = { task.attempt == 1 ? '2h' : task.attempt == 2 ? '8h' : '24h' }
        cpus           = 32
    }
    withName: 'MASKREPEAT_TANTAN_RUN' {
        queue  = 'short'
        cpus   = 2
        memory = '1 GB'
        time   = '2h'
    }
    withName: 'RNASEQ_PREPARE' {
        cpus           = 16
        // Attempt 1 (24h, 16 GB) fits preempt's 1-day cap on general nodes;
        // later retries escalate memory/time and fall back to the default queue.
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        // c01-c30 are old AMD "Abu Dhabi" CPUs with no AVX2; this process runs
        // `funannotate train --stop_after_trinity`, whose hisat2-build step
        // SIGILL-crashes instantly on them. See the exclude note on
        // FUNANNOTATE_TRAIN below for the same failure mode.
        clusterOptions = { task.attempt == 1 ? '-N 1 -n 1 --account=preempt --exclude=c[01-30]' : '-N 1 -n 1 --exclude=c[01-30]' }
        memory         = { task.attempt == 1 ? '16 GB' : (48 + (task.attempt - 1) * 48) + ' GB' }
        time           = { (task.attempt * 24) + 'h' }
        maxRetries     = 3
    }
    withName: 'FUNANNOTATE_TRAIN' {
        maxRetries     = 3
        // Attempt 1 (24h, 16 GB) fits preempt's 1-day cap; attempt 2 falls back
        // to the default queue, attempt 3+ escalates to highmem as before.
        // 2 GB was too low: Trinity's genome-guided step alone launches with
        // `java -Xmx4g`, so hisat2+Trinity would get OOM-killed by the SLURM
        // cgroup before ever writing hisat2.coordSorted.bam. Worse, funannotate
        // train swallowed that failure and exited 0, so Nextflow saw the task
        // as COMPLETED and never triggered a retry.
        queue          = { task.attempt == 1 ? 'preempt' : (task.attempt == 2 ? '' : 'highmem') }
        memory         = { (16 + (task.attempt - 1) * 4) + ' GB' }
        cpus           = { task.attempt == 1 ? 4 : 8 }
        time           = { (task.attempt * 24) + 'h' }
        // c01-c30 are old AMD "Abu Dhabi" CPUs with no AVX2; funannotate's compiled
        // binaries (augustus, bam2hints, etc.) SIGILL-crash on them instantly with no
        // stderr, which showed up as "bam2hints CMD ERROR" / "augustus test failed"
        // failures that looked random but always landed on a c-node.
        clusterOptions = { task.attempt == 1 ? '--job-name=nf-TRAIN --account=preempt --exclude=c[01-30]' : '--job-name=nf-TRAIN --exclude=c[01-30]' }
    }
    withName: 'FUNANNOTATE_PREDICT' {
        // Attempt 1 (24h, 12 GB) fits preempt's 1-day cap; later retries
        // escalate memory/time/cpus and fall back to the default queue.
        queue          = { task.attempt == 1 ? 'preempt' : '' }
        memory         = { (task.attempt  * 12) + ' GB' }
        time           = { (task.attempt * 24) + 'h' }
        cpus           = { task.attempt * 4 }
        // c01-c30 are old AMD "Abu Dhabi" CPUs with no AVX2; see note on FUNANNOTATE_TRAIN.
        clusterOptions = { task.attempt == 1 ? '--job-name=nf-PREDICT --account=preempt --exclude=c[01-30]' : '--job-name=nf-PREDICT --exclude=c[01-30]' }
    }
    withName: 'SIGNALP_RUN' {
        queue          = 'exfab'
        cpus           = 16
        memory         = '64 GB'
        time           = '2h'
        clusterOptions = '--gres=gpu:1 -N 1 -n 1'
    }
    withName: 'INTERPROSCAN_RUN' {
        queue  = 'epyc'
        cpus   = 8
        memory = '32 GB'
        time   = '60h'
    }
    withName: 'ANTISMASH_RUN' {
        // Fits within preempt's 1-day cap on general-purpose hardware; route
        // there for cheaper throughput.
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        memory = '24 GB'
        time   = '8h'
    }
    withName: 'FUNANNOTATE_ANNOTATE' {
        // Fits within preempt's 1-day cap (time == 24h) on general-purpose
        // hardware; route there for cheaper throughput.
        queue          = 'preempt'
        clusterOptions = '-N 1 -n 1 --account=preempt'
        memory = '64 GB'
        time   = '24h'
    }

    // ── ANI processes (used by ANI_REPRESENTATIVE_SELECT) ──────────────────────
    withLabel: 'skani' {
        container      = 'docker://quay.io/biocontainers/skani:0.3.2--h79ce301_0'
        time           = '8 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }
    withLabel: 'mash' {
        container      = 'docker://quay.io/biocontainers/mash:2.3--hb105d93_10'
        time           = '8 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }
    withLabel: 'sourmash' {
        container      = 'docker://quay.io/biocontainers/sourmash:4.9.4--hdfd78af_0'
        time           = '12 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }
    withLabel: 'fastani' {
        container      = 'docker://quay.io/biocontainers/fastani:1.34--hb66fcc3_5'
        time           = '24 h'
        queue          = 'epyc'
        stageInMode    = 'symlink'
        clusterOptions = '-N 1 -n 1'
    }
    withLabel: 'report' {
        container = 'docker://python:3.12'
        cpus      = 1
        memory    = '4 GB'
        time      = '2 h'
        queue     = 'short'
    }
    withName: '.*_SKETCH' {
        time  = '1 h'
        queue = 'short'
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/funannotate_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/funannotate_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/funannotate_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
