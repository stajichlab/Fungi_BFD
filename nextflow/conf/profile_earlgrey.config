/*
 * earlgrey profile: earlgrey_mask.nf — curated repeat masking of large genomes.
 *
 * EarlGrey + RepeatMasker run from environment modules (loaded inside each process),
 * so no Singularity image is needed.
 *
 * Queue / resource defaults are tuned for the UCR HPCC cluster.
 * Override individual values with --param value or a params-file.
 */

workDir = "${launchDir}/work/earlgrey"

params.genome_dir           = "${launchDir}/input_clean_genomes"
params.genome_suffix        = '.fa'
// Representative selection reads the merged BFD database tables (same tables/
// dir MERGE_ASM_STATS / MERGE_BUSCO_GENOME publish into for the funannotate
// pipeline's PICK_REPRESENTATIVE_STRAIN) rather than a standalone tsv.gz —
// asm_stats.tsv.gz is an intermediate MERGE_ASM_STATS deletes after producing
// the parquet, so it never actually exists in tables/.
params.asm_stats_parquet    = "${params.tables}/asm_stats.parquet"
params.busco_genome_parquet = "${params.tables}/busco_genome.parquet"
params.cutoff_mb            = 200
params.repeat_taxon         = 'fungi'
params.earlgrey_version     = '7.2.6'
params.repeatmasker_version = '4.1.8'
params.outdir               = "${launchDir}/results/repeatlibrary"
params.masked_dir           = "${launchDir}/input_clean_genomes"
params.earlgrey_workdir     = "${launchDir}/work/earlgrey_persist"

process {

    withLabel: 'earlgrey_build' {
        maxRetries     = 4
        cpus           = { task.attempt == 1 ? 32 : 48 }
        memory         = { task.attempt == 1 ? '96 GB' : task.attempt == 2 ? '128 GB' : '256 GB' }
        time           = { task.attempt == 1 ? '5.day' : '7.day' }
        queue          = { task.attempt == 1 ? "" : "highmem" }
        clusterOptions = '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR='  // see nextflow.config process.clusterOptions comment
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load earlgrey/${params.earlgrey_version}
        """
    }

    withLabel: 'earlgrey_repeatmask' {
        cpus           = 32
        memory         = '32 GB'
        time           = '2h'
        clusterOptions = '-N 1 -n 1 --export=ALL,SCRATCH=,TMPDIR='  // see nextflow.config process.clusterOptions comment
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load RepeatMasker/${params.repeatmasker_version}
        """
    }

    withLabel: 'earlgrey_deliver' {
        cpus   = 1
        memory = '2 GB'
        time   = '30.m'
        queue  = 'short'
    }

    withLabel: 'earlgrey_select' {
        cpus   = 1
        memory = '4 GB'
        time   = '30.m'
        queue  = 'short'
        beforeScript = """
            source /etc/profile.d/modules.sh 2>/dev/null || true
            module load biopython
        """
    }
}

trace {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/earlgrey_trace.${params.trace_report_suffix}.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,rss,tag'
}
report {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/earlgrey_report.${params.trace_report_suffix}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${launchDir}/logs/nextflow/earlgrey_timeline.${params.trace_report_suffix}.html"
    overwrite = true
}
