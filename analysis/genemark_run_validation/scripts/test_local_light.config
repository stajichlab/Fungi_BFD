// Same as test_local.config but lighter (cpus=2) for the fast-reuse
// (--predict_with) test, so it doesn't contend for CPU with the concurrently
// running fresh-ES test on this 8-core interactive session.
process {
    executor = 'local'
    withName: 'GENEMARK_RUN' { cpus = 2; memory = '8 GB' }
}
