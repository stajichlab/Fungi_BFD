+def pick_locus_model(feats, expression, complete_min_frac=0.8):
+    """Choose one model from a locus cluster.
+
+    feats: {gene_id: (complete_orf, n_cds_exons, cds_len)}; expression: {gene_id: TPM}.
+    A complete ORF is preferred only when its CDS is at least complete_min_frac
+    of the locus's longest CDS; otherwise structure decides (CDS exons, then CDS
+    length), then TPM, then ID. Unconditional complete-first let a short internal
+    ORF (often a wrong downstream start) beat the long 5'-partial model it sits
+    in: on the RefSeq benchmark this lost 117-235 correct intron chains per
+    genome while adding only 0-20 exact CDS matches (DECISIONS D55).
+    """
+    longest = max(f[2] for f in feats.values())
+
+    def key(gid):
+        complete, n_cds, cds_len = feats[gid]
+        return (bool(complete) and cds_len >= complete_min_frac * longest,
+                n_cds, cds_len, expression.get(gid, 0.0), gid)
+
+    return max(feats, key=key)
+
